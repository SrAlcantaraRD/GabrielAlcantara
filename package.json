{
	"name": "cv",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"prepare": "node scripts/install-git-hooks.mjs",
		"build": "node scripts/check-social-cards.mjs && astro build && node scripts/element-ids.mjs --dist",
		"preview": "astro preview",
		"test": "node --test 'tests/**/*.test.ts'",
		"typecheck": "astro check",
		"astro": "astro",
		"ui:check": "node scripts/ui-check.mjs",
		"hooks:install": "node scripts/install-git-hooks.mjs",
		"social:cards": "node docs/og-image/export.mjs",
		"social:check": "node scripts/check-social-cards.mjs",
		"url:baseline": "node scripts/url-baseline.mjs",
		"url:baseline:write": "node scripts/url-baseline.mjs --write",
		"deploy:production": "pnpm test && pnpm build && pnpm url:baseline"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@fontsource/newsreader": "^5.3.0",
		"astro": "^7.4.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@types/node": "^26.6.6",
		"playwright-core": "^1.65.0",
		"typescript": "^6.0.3"
	}
}
