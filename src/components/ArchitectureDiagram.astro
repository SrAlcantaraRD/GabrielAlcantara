---
/**
 * Architecture diagram for the Nakire TPS case study.
 *
 * Hand-authored SVG: no runtime, no external request, and readable text for
 * search engines and agents. The surrounding page repeats the same structure
 * as a text list, so the diagram is never the only place the information lives.
 *
 * The styles live in their own stylesheet, linked below: a `<style>` block here
 * would ride along with every page whose body registry reaches this component.
 */
import architectureDiagramStyles from "../styles/architecture-diagram.css?url";
---

<link id="architecture-diagram-link" rel="stylesheet" href={architectureDiagramStyles} />
<figure id="architecture-diagram" class="diagram">
  <div id="architecture-diagram-scroll" class="diagram-scroll">
    <svg id="architecture-diagram-scroll-svg"
      viewBox="0 0 900 545"
      role="img"
      aria-labelledby="arch-title arch-desc"
      preserveAspectRatio="xMidYMin meet"
    >
      <title id="arch-title">Arquitectura de Nakire TPS</title>
      <desc id="arch-desc">
        Un frontend reactivo por rol se conecta a una API, que delega en un core de
        agentes —dictator, ranker y distributor—. El core publica y consume eventos
        en un bus. Cada familia de dispositivo (carretillas, PLC, LEDs, picking y
        cámaras) tiene su propio microservicio con adaptadores por modelo, versión y
        protocolo, y conversa con el hardware real del almacén.
      </desc>

      <defs id="architecture-diagram-scroll-defs">
        <marker
          id="arch-arrow"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path id="architecture-diagram-scroll-arch-arrowhead" d="M 0 0 L 10 5 L 0 10 z" class="arch-arrowhead" />
        </marker>
      </defs>

      <!-- Top row -->
      <g id="architecture-diagram-scroll-g">
        <rect id="architecture-diagram-scroll-arch-box" class="arch-box" x="20" y="16" width="270" height="74" rx="8" />
        <text id="architecture-diagram-scroll-arch-title" class="arch-title" x="38" y="43">Frontend por rol</text>
        <text id="architecture-diagram-scroll-arch-sub" class="arch-sub" x="38" y="63">WebSocket · RBAC · admin y operador</text>
        <text id="architecture-diagram-scroll-arch-sub-2" class="arch-sub" x="38" y="79">la interfaz se adapta al tipo de operador</text>
      </g>

      <g id="architecture-diagram-scroll-g-2">
        <rect id="architecture-diagram-scroll-arch-box-2" class="arch-box" x="315" y="16" width="270" height="74" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-2" class="arch-title" x="333" y="43">API y backend</text>
        <text id="architecture-diagram-scroll-arch-sub-3" class="arch-sub" x="333" y="63">casos de uso · puertos y adaptadores</text>
        <text id="architecture-diagram-scroll-arch-sub-4" class="arch-sub" x="333" y="79">autenticación y autorización</text>
      </g>

      <g id="architecture-diagram-scroll-g-3">
        <rect id="architecture-diagram-scroll-arch-box-3" class="arch-box arch-box--soft" x="610" y="16" width="270" height="74" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-3" class="arch-title" x="628" y="43">Operación y personas</text>
        <text id="architecture-diagram-scroll-arch-sub-5" class="arch-sub" x="628" y="63">tareas, prioridades y estado</text>
        <text id="architecture-diagram-scroll-arch-sub-6" class="arch-sub" x="628" y="79">cada rol ve lo que puede ejecutar</text>
      </g>

      <!-- Core -->
      <g id="architecture-diagram-scroll-g-4">
        <rect id="architecture-diagram-scroll-arch-box-4" class="arch-box arch-box--core" x="20" y="130" width="860" height="78" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-4" class="arch-title" x="40" y="159">Core de agentes · tareas atómicas</text>
        <text id="architecture-diagram-scroll-arch-sub-7" class="arch-sub" x="40" y="181">
          dictator ordena · ranker prioriza · distributor delega entre dispositivos
          disponibles
        </text>
        <text id="architecture-diagram-scroll-arch-sub-8" class="arch-sub" x="40" y="197">
          abstracción por casos de uso: del dispositivo concreto a solo la familia y la acción
        </text>
      </g>

      <!-- Bus -->
      <g id="architecture-diagram-scroll-g-5">
        <rect id="architecture-diagram-scroll-arch-bus" class="arch-bus" x="20" y="248" width="860" height="44" rx="22" />
        <text id="architecture-diagram-scroll-arch-bus-text" class="arch-bus-text" x="450" y="275">Bus de eventos · comunicación asíncrona entre servicios</text>
      </g>

      <!-- Device services -->
      <g id="architecture-diagram-scroll-g-6">
        <rect id="architecture-diagram-scroll-arch-box-5" class="arch-box" x="20" y="332" width="160" height="96" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-5" class="arch-title arch-title--sm" x="36" y="359">Carretillas</text>
        <text id="architecture-diagram-scroll-arch-sub-9" class="arch-sub" x="36" y="379">microservicio</text>
        <text id="architecture-diagram-scroll-arch-sub-10" class="arch-sub" x="36" y="396">adaptador por</text>
        <text id="architecture-diagram-scroll-arch-sub-11" class="arch-sub" x="36" y="413">modelo y versión</text>
      </g>

      <g id="architecture-diagram-scroll-g-7">
        <rect id="architecture-diagram-scroll-arch-box-6" class="arch-box" x="195" y="332" width="160" height="96" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-6" class="arch-title arch-title--sm" x="211" y="359">PLC</text>
        <text id="architecture-diagram-scroll-arch-sub-12" class="arch-sub" x="211" y="379">microservicio</text>
        <text id="architecture-diagram-scroll-arch-sub-13" class="arch-sub" x="211" y="396">señales y estados</text>
        <text id="architecture-diagram-scroll-arch-sub-14" class="arch-sub" x="211" y="413">de la instalación</text>
      </g>

      <g id="architecture-diagram-scroll-g-8">
        <rect id="architecture-diagram-scroll-arch-box-7" class="arch-box" x="370" y="332" width="160" height="96" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-7" class="arch-title arch-title--sm" x="386" y="359">LEDs y sonido</text>
        <text id="architecture-diagram-scroll-arch-sub-15" class="arch-sub" x="386" y="379">microservicio</text>
        <text id="architecture-diagram-scroll-arch-sub-16" class="arch-sub" x="386" y="396">guía física al</text>
        <text id="architecture-diagram-scroll-arch-sub-17" class="arch-sub" x="386" y="413">operador</text>
      </g>

      <g id="architecture-diagram-scroll-g-9">
        <rect id="architecture-diagram-scroll-arch-box-8" class="arch-box" x="545" y="332" width="160" height="96" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-8" class="arch-title arch-title--sm" x="561" y="359">Picking</text>
        <text id="architecture-diagram-scroll-arch-sub-18" class="arch-sub" x="561" y="379">microservicio</text>
        <text id="architecture-diagram-scroll-arch-sub-19" class="arch-sub" x="561" y="396">tareas de</text>
        <text id="architecture-diagram-scroll-arch-sub-20" class="arch-sub" x="561" y="413">preparación</text>
      </g>

      <g id="architecture-diagram-scroll-g-10">
        <rect id="architecture-diagram-scroll-arch-box-9" class="arch-box" x="720" y="332" width="160" height="96" rx="8" />
        <text id="architecture-diagram-scroll-arch-title-9" class="arch-title arch-title--sm" x="736" y="359">Cámaras</text>
        <text id="architecture-diagram-scroll-arch-sub-21" class="arch-sub" x="736" y="379">microservicio</text>
        <text id="architecture-diagram-scroll-arch-sub-22" class="arch-sub" x="736" y="396">lectura y</text>
        <text id="architecture-diagram-scroll-arch-sub-23" class="arch-sub" x="736" y="413">verificación</text>
      </g>

      <!-- Hardware -->
      <g id="architecture-diagram-scroll-g-11">
        <rect id="architecture-diagram-scroll-arch-hardware" class="arch-hardware" x="20" y="462" width="860" height="46" rx="8" />
        <text id="architecture-diagram-scroll-arch-bus-text-2" class="arch-bus-text" x="450" y="489">
          Hardware real del almacén · robots · PLC · LEDs · picking · cámaras
        </text>
      </g>

      <!-- Arrows -->
      <line id="architecture-diagram-scroll-arch-line" class="arch-line" x1="450" y1="90" x2="450" y2="126" marker-end="url(#arch-arrow)" />
      <line id="architecture-diagram-scroll-arch-line-2" class="arch-line" x1="450" y1="208" x2="450" y2="244" marker-end="url(#arch-arrow)" />
      <line id="architecture-diagram-scroll-arch-line-3" class="arch-line" x1="450" y1="292" x2="450" y2="328" marker-end="url(#arch-arrow)" />
      <line id="architecture-diagram-scroll-arch-line-4" class="arch-line" x1="450" y1="428" x2="450" y2="458" marker-end="url(#arch-arrow)" />
      <line id="architecture-diagram-scroll-arch-line-5" class="arch-line" x1="100" y1="428" x2="100" y2="458" marker-end="url(#arch-arrow)" />
      <line id="architecture-diagram-scroll-arch-line-6" class="arch-line" x1="800" y1="428" x2="800" y2="458" marker-end="url(#arch-arrow)" />
    </svg>
  </div>

  <figcaption id="architecture-diagram-figcaption">
    Vista simplificada: el frontend y la API hablan con el core, el core coordina
    por eventos y cada familia de dispositivo mantiene su propio servicio y sus
    adaptadores. El despliegue corre en Docker sobre cloud, bajo VPN, con CI/CD y
    QA gates sobre hardware físico real.
  </figcaption>
</figure>

