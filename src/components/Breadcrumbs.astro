---
import { localeRoot, type Locale } from "../i18n/routing";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  items: { label: string; href?: string }[];
  hidden?: boolean;
  lang?: Locale;
}

const {
  items,
  hidden = false,
  lang = getLangFromUrl(Astro.url),
} = Astro.props;
const t = useTranslations(lang);
---

<nav id="breadcrumbs" class="breadcrumbs" aria-label={t("breadcrumbs")} hidden={hidden}>
  <ol id="breadcrumbs-ol">
    <li id="breadcrumbs-li"><a id="breadcrumbs-a" href={localeRoot(lang)}>{t("nav.home")}</a></li>
    {
      items.map((item, i) => (
        <li id={`breadcrumbs-li-2-${i}`}>
          {item.href ? (
            <a id={`breadcrumbs-a-2-${i}`} href={item.href}>{item.label}</a>
          ) : (
            <span id={`breadcrumbs-span-${i}`} aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    min-inline-size: 0;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 0.35rem;
    min-inline-size: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }

  .breadcrumbs li {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .breadcrumbs li:last-child {
    min-inline-size: 0;
  }

  .breadcrumbs li + li::before {
    content: "/";
    color: var(--color-border);
  }

  .breadcrumbs a {
    color: var(--color-ink-faint);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumbs [aria-current="page"] {
    overflow: hidden;
    color: var(--color-ink-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
