---
import { DOMAIN_LABEL, PILLAR_LABEL, PROJECTS } from "../data/cv";
import { openDrawer } from "../lib/open-drawer";

const payload = {
	projects: PROJECTS,
	domain: DOMAIN_LABEL,
	pillar: PILLAR_LABEL,
};
---

<div class="drawer-backdrop" data-drawer-close></div>

<aside
  class="drawer"
  id="project-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-title"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="drawer-surface">
  <header class="drawer-head">
    <div>
      <p class="drawer-meta" id="drawer-meta"></p>
      <h2 class="drawer-title" id="drawer-title"></h2>
      <p class="drawer-role" id="drawer-role"></p>
    </div>
    <button
      type="button"
      class="drawer-close"
      id="drawer-close"
      aria-label="cerrar ficha"
      data-drawer-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </header>

  <div class="drawer-body" id="drawer-body"></div>

  <footer class="drawer-foot">
    <span class="drawer-hint" id="drawer-hint">presiona esc para cerrar</span>
    <button type="button" class="drawer-ok" data-drawer-close>entendido</button>
  </footer>
  </div>
</aside>

<script type="application/json" id="drawer-data" set:html={JSON.stringify(payload)} />

<script>
  import type { DrawerRequest } from "../lib/open-drawer";
  import type { Project } from "../data/cv";
  import { durationLabel, spanLabel } from "../lib/period";

  interface Payload {
    projects: Project[];
    domain: Record<string, string>;
    pillar: Record<string, string>;
  }

  let stop: (() => void) | null = null;

  boot();

  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => {
    stop?.();
    stop = null;
    document.body.style.overflow = "";
  });

  function boot() {
    const panel = document.querySelector<HTMLElement>("#project-drawer");
    if (!panel || panel.dataset.drawerReady === "true") return;
    stop?.();
    panel.dataset.drawerReady = "true";
    stop = init(panel);
  }

  function init(panel: HTMLElement): () => void {
    const backdrop = document.querySelector<HTMLElement>(".drawer-backdrop");
    const meta = must<HTMLElement>("#drawer-meta");
    const title = must<HTMLElement>("#drawer-title");
    const role = must<HTMLElement>("#drawer-role");
    const body = must<HTMLElement>("#drawer-body");
    const dataScript = must<HTMLScriptElement>("#drawer-data");

    const payload = JSON.parse(dataScript.textContent ?? "{}") as Payload;
    const projectById = new Map(
      payload.projects.map((project) => [project.id, project]),
    );
    const controller = new AbortController();
    let restoreFocus: HTMLElement | null = null;

    window.addEventListener("cv:open", (event) => {
      const request = (event as CustomEvent<DrawerRequest>).detail;
      if (!request) return;
      render(request);
      open(request.origin ?? null);
    }, { signal: controller.signal });

    for (const closer of document.querySelectorAll("[data-drawer-close]")) {
      closer.addEventListener("click", close, { signal: controller.signal });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
        return;
      }
      if (event.key === "Tab" && panel.classList.contains("is-open")) {
        trapFocus(event);
      }
    }, { signal: controller.signal });

    function render(request: DrawerRequest) {
      if (request.kind === "project") {
        const project = projectById.get(request.id);
        if (!project) return;
        meta.textContent = `proyecto · ${project.position}`;
        title.textContent = project.name;
        role.textContent = `${project.company} · ${project.position} · ${spanLabel(project.startMonth, project.endMonth)} (${durationLabel(project.endMonth - project.startMonth)})`;
        body.replaceChildren(projectBody(project));
        return;
      }

      meta.textContent = request.label;
      title.textContent = `${request.ids.length} proyectos`;
      role.textContent = "selecciona uno para abrir su ficha";
      body.replaceChildren(listBody(request.ids));
    }

    function projectBody(project: Project): HTMLElement {
      const fragment = document.createDocumentFragment();

      fragment.append(element("p", "drawer-text", project.summary));

      if (project.achievements.length > 0) {
        const block = element("section", "drawer-block");
        block.append(element("span", "eyebrow", "hitos"));
        const list = element("ul", "drawer-list");
        for (const achievement of project.achievements) {
          list.append(element("li", undefined, achievement));
        }
        block.append(list);
        fragment.append(block);
      }

      const chips = element("section", "drawer-block");
      chips.append(element("span", "eyebrow", "etiquetas"));
      const chipRow = element("p", "drawer-chips");
      chipRow.append(element("span", "pill", payload.domain[project.domain]));
      for (const pillar of project.pillars) {
        chipRow.append(element("span", "pill", payload.pillar[pillar] ?? pillar));
      }
      chips.append(chipRow);
      fragment.append(chips);

      if (project.stack && project.stack.length > 0) {
        const stack = element("section", "drawer-block");
        stack.append(element("span", "eyebrow", "tecnologías clave"));
        const stackRow = element("p", "drawer-chips");
        for (const item of project.stack) {
          stackRow.append(element("span", "pill", item));
        }
        stack.append(stackRow);
        fragment.append(stack);
      }

      const wrapper = element("div", "drawer-stack");
      wrapper.append(fragment);
      return wrapper;
    }

    function listBody(ids: string[]): HTMLElement {
      const list = element("ul", "drawer-picker");
      for (const id of ids) {
        const project = projectById.get(id);
        if (!project) continue;
        const item = element("li");
        const button = element("button", "drawer-pick", project.name);
        button.type = "button";
        button.addEventListener("click", () => {
          render({ kind: "project", id });
          focusPanel();
        });
        item.append(
          button,
          element(
            "span",
            "drawer-pick-meta",
            `${project.company} · ${spanLabel(project.startMonth, project.endMonth)}`,
          ),
        );
        list.append(item);
      }
      return list;
    }

    const EASE_IN = "cubic-bezier(.22, 1, .36, 1)";
    const EASE_OUT = "cubic-bezier(.4, 0, .2, 1)";
    const MORPH_MS = 460;
    const SHRINK_MS = 320;

    let origin: HTMLElement | null = null;
    let originRect: DOMRect | null = null;
    let morph: Animation | null = null;
    let closing: (() => void) | null = null;

    function open(from: Element | null) {
      closing?.();
      if (panel.classList.contains("is-open")) return;
      restoreFocus =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      origin = from instanceof HTMLElement ? from : null;
      originRect = origin?.getBoundingClientRect() ?? null;
      panel.classList.add("is-open");
      panel.setAttribute("aria-hidden", "false");
      backdrop?.classList.add("is-open");
      document.body.style.overflow = "hidden";
      morphIn();
      requestAnimationFrame(focusPanel);
    }

    function focusPanel() {
      panel.focus({ preventScroll: true });
    }

    function prefersReducedMotion(): boolean {
      return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    }

    /** The bar's own colour, so the card grows out of that row, not out of nowhere. */
    function originColor(): string | null {
      if (!origin) return null;
      const color = getComputedStyle(origin).backgroundColor;
      return /rgba?\([^)]*,\s*0\s*\)/.test(color) ? null : color;
    }

    /** The bar expands into the card: one transform, so it never leaves the compositor. */
    function morphIn() {
      if (!originRect || prefersReducedMotion() || typeof panel.animate !== "function") {
        return;
      }
      const to = panel.getBoundingClientRect();
      if (!to.width || !to.height) return;
      const sx = Math.max(0.02, originRect.width / to.width);
      const sy = Math.max(0.02, originRect.height / to.height);
      const shell = getComputedStyle(panel).backgroundColor;
      const from = originColor() ?? shell;
      morph?.cancel();
      morph = panel.animate(
        [
          {
            transformOrigin: "0 0",
            transform: `translate(${originRect.left - to.left}px, ${originRect.top - to.top}px) scale(${sx}, ${sy})`,
            borderRadius: "4px",
            backgroundColor: from,
          },
          {
            transformOrigin: "0 0",
            transform: "none",
            borderRadius: "14px",
            backgroundColor: shell,
          },
        ],
        { duration: MORPH_MS, easing: EASE_IN },
      );
      morph.finished.then(() => {
        morph = null;
      }).catch(() => {});
    }

    function close() {
      if (!panel.classList.contains("is-open") || closing) return;
      const target =
        origin && origin.isConnected ? origin.getBoundingClientRect() : originRect;
      if (prefersReducedMotion() || !target || typeof panel.animate !== "function") {
        finishClose();
        return;
      }
      const from = panel.getBoundingClientRect();
      const sx = Math.max(0.02, target.width / from.width);
      const sy = Math.max(0.02, target.height / from.height);
      const shell = getComputedStyle(panel).backgroundColor;
      const to = originColor() ?? shell;
      panel.dataset.closing = "true";
      backdrop?.classList.remove("is-open");
      morph?.cancel();
      morph = panel.animate(
        [
          {
            transformOrigin: "0 0",
            transform: "none",
            borderRadius: "14px",
            backgroundColor: shell,
          },
          {
            transformOrigin: "0 0",
            transform: `translate(${target.left - from.left}px, ${target.top - from.top}px) scale(${sx}, ${sy})`,
            borderRadius: "4px",
            backgroundColor: to,
          },
        ],
        { duration: SHRINK_MS, easing: EASE_OUT },
      );
      closing = finishClose;
      morph.finished.then(finishClose).catch(() => {});
    }

    function finishClose() {
      const animation = morph;
      morph = null;
      closing = null;
      animation?.cancel();
      delete panel.dataset.closing;
      panel.classList.remove("is-open");
      panel.setAttribute("aria-hidden", "true");
      backdrop?.classList.remove("is-open");
      document.body.style.overflow = "";
      restoreFocus?.focus({ preventScroll: true });
    }

    function trapFocus(event: KeyboardEvent) {
      const focusable = Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((node) => node.getClientRects().length > 0);
      if (focusable.length === 0) {
        event.preventDefault();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || active === panel)) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    }

    return () => {
      controller.abort();
      morph?.cancel();
      morph = null;
      closing = null;
      if (panel.classList.contains("is-open")) {
        panel.classList.remove("is-open");
        panel.setAttribute("aria-hidden", "true");
        backdrop?.classList.remove("is-open");
      }
    };
  }

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function must<T extends Element>(selector: string): T {
    const node = document.querySelector<T>(selector);
    if (!node) throw new Error(`drawer markup is missing ${selector}`);
    return node;
  }
</script>

<style is:global>
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(26 26 26 / 0.28);
    backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms ease,
      visibility 0s 200ms;
  }

  .drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 200ms ease,
      visibility 0s;
  }

  /*
   * A centred card, not a side panel: the bar it comes from expands into this
   * box, so the dialog has to be a rectangle the bar can grow into.
   */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    margin: auto;
    inline-size: min(42rem, calc(100vw - 1.5rem));
    block-size: fit-content;
    max-block-size: min(86vh, 46rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-card);
    box-shadow:
      0 32px 72px -16px rgb(26 26 26 / 0.4),
      0 2px 8px rgb(26 26 26 / 0.08);
    visibility: hidden;
    opacity: 0;
  }

  .drawer.is-open {
    visibility: visible;
    opacity: 1;
  }

  /*
   * The shell moves on its own clock; the copy settles after it: fade, blur and
   * a touch of scale, so the card is already in place when the words arrive.
   */
  .drawer-surface {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-block-size: 0;
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.984);
    transition:
      opacity 240ms ease 240ms,
      filter 320ms ease 240ms,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1) 220ms;
  }

  .drawer.is-open .drawer-surface {
    opacity: 1;
    filter: none;
    transform: none;
  }

  .drawer[data-closing="true"] .drawer-surface {
    opacity: 0;
    filter: blur(6px);
    transform: scale(0.99);
    transition-duration: 140ms;
    transition-delay: 0ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer-surface {
      filter: none;
      transform: none;
      transition: opacity 140ms ease;
    }
  }

  .drawer:focus {
    outline: none;
  }

  .drawer-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.75rem 1.9rem 1.35rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-card);
  }

  .drawer-meta {
    font-family: var(--font-mono);
    font-size: 0.656rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .drawer-title {
    margin-top: 0.2rem;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .drawer-role {
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .drawer-close {
    display: grid;
    place-items: center;
    margin: -0.35rem -0.5rem 0 0;
    padding: 0.4rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-ink-faint);
    cursor: pointer;
    transition: color 140ms ease;
  }

  .drawer-close:hover {
    color: var(--color-ink);
  }

  .drawer-close svg {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .drawer-body {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    padding: 1.5rem 1.9rem 1.75rem;
  }

  .drawer-stack {
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .drawer-text {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  .drawer-block {
    display: grid;
    gap: 0.6rem;
  }

  .drawer-list {
    display: grid;
    gap: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .drawer-list li {
    position: relative;
    padding-inline-start: 0.9rem;
  }

  .drawer-list li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55em;
    inline-size: 0.35rem;
    block-size: 1px;
    background: var(--color-ink-faint);
  }

  .drawer-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .drawer-picker {
    display: grid;
    gap: 0.75rem;
  }

  .drawer-picker li {
    display: grid;
    gap: 0.1rem;
  }

  .drawer-pick {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .drawer-pick:hover {
    text-decoration-color: var(--color-ink);
  }

  .drawer-pick-meta {
    font-family: var(--font-mono);
    font-size: 0.656rem;
    color: var(--color-ink-faint);
  }

  .drawer-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.9rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-card);
  }

  .drawer-hint {
    font-family: var(--font-mono);
    font-size: 0.656rem;
    color: var(--color-ink-faint);
  }

  .drawer-ok {
    padding: 0.4rem 0.9rem;
    border: 0;
    border-radius: 4px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    cursor: pointer;
    transition: background 140ms ease;
  }

  .drawer-ok:hover {
    background: var(--color-ink-hover);
  }

  @media (max-width: 640px) {
    .drawer {
      inline-size: calc(100vw - 1.25rem);
      max-block-size: 88vh;
      border-radius: 12px;
    }

    .drawer-head,
    .drawer-body,
    .drawer-foot {
      padding-inline: 1.15rem;
    }
  }
</style>
