---
import PreviewCard from "./PreviewCard.astro";
import PreviewTerm from "./PreviewTerm.astro";
import { AXIS_LABEL, AXIS_ORDER, type AxisId } from "../lib/matrix";
import {
	COMPANIES,
	MONTH_RANGE,
	POSITION_VIEWS,
	PROJECTS,
	YEAR_LABEL,
	DOMAIN_LABEL,
	DOMAIN_ORDER,
	PILLAR_LABEL,
	PILLAR_ORDER,
} from "../data/cv";

const defaultY: AxisId = "company";

const payload = {
	projects: PROJECTS,
	positions: POSITION_VIEWS,
	companies: COMPANIES,
	range: MONTH_RANGE,
	config: {
		pillar: PILLAR_LABEL,
		domain: DOMAIN_LABEL,
		pillarOrder: PILLAR_ORDER,
		domainOrder: DOMAIN_ORDER,
	},
};
---

<div class="matrix" id="matriz">
  <div id="experience-matrix-panel" class="matrix-panel">
    <div id="experience-matrix-panel-head" class="panel-head">
      <div id="experience-matrix-panel-head-group-grid" class="group-grid" role="group" aria-label="agrupar las filas por">
        {
          AXIS_ORDER.filter(
            (axisId) => axisId !== "time" && axisId !== "project",
          ).map((axisId, i) => (
            <button id={`experience-matrix-group-grid-chip-${i}`}
              type="button"
              class="chip"
              data-axis="y"
              data-value={axisId}
              aria-pressed={axisId === defaultY ? "true" : "false"}
            >
              {AXIS_LABEL[axisId]}
            </button>
          ))
        }
      </div>
      <span id="experience-matrix-panel-head-range" class="panel-range">
        <span id="matrix-range">{YEAR_LABEL}</span>
        <span class="panel-note" id="matrix-note" hidden>
          cada celda recorre la línea temporal completa
        </span>
      </span>
      <div id="experience-matrix-panel-head-window" class="window" role="group" aria-label="ventana temporal">
        {
          COMPANIES.map((company, i2) => (
            <button id={`experience-matrix-window-wchip-${i2}`}
              type="button"
              class="wchip"
              data-window={company.id}
              data-accent={company.accent}
              aria-pressed="false"
            >
              {company.short}
            </button>
          ))
        }
      </div>
    </div>

    <div id="experience-matrix-panel-surface" class="matrix-surface">
      <div class="matrix-grid" id="matrix-grid" data-mode="timeline"></div>
    </div>
  </div>

  <div id="experience-matrix-foot" class="matrix-foot">
    <ul id="experience-matrix-foot-legend" class="legend" aria-label="etapas">
      {
        COMPANIES.map((company, i3) => (
          <li id={`experience-matrix-legend-li-${i3}`}>
            <span id={`experience-matrix-legend-dot-${i3}`}
              class="legend-dot"
              data-accent={company.accent}
              aria-hidden="true"
            />
            <PreviewTerm slug={company.id} card={false} idSuffix="matrix">
              {company.name}
            </PreviewTerm>
          </li>
        ))
      }
    </ul>

    {/*
      One card per company, hidden: the row and column labels are built in the
      browser, so each label is a trigger pointing at the card rendered here.
    */}
    {COMPANIES.map((company) => (
      <PreviewCard slug={company.id} idSuffix="matrix" />
    ))}
  </div>

  <noscript id="experience-matrix-noscript">
    <p id="experience-matrix-hint" class="matrix-hint">
      activa javascript para recorrer la matriz; las fichas de abajo cuentan la
      misma trayectoria en texto.
    </p>
  </noscript>

  <div class="matrix-tip" id="matrix-tip" role="tooltip" hidden></div>

  <script type="application/json" id="matrix-data" set:html={JSON.stringify(payload)} />
</div>

<script>
  import {
    axesAreValid,
    axisValues,
    cellBars,
    isAxisId,
    monthPct,
    packLanes,
    positionKey,
    rowBars,
    type AxisConfig,
    type AxisId,
    type AxisValue,
    type Bar,
    type MonthRange,
  } from "../lib/matrix";
  import type { Company, PositionView, Project } from "../data/cv";
  import { durationLabel, monthLabel, spanLabel } from "../lib/period";
  import { openDrawer } from "../lib/open-drawer";

  interface Payload {
    projects: Project[];
    positions: PositionView[];
    companies: Company[];
    config: AxisConfig;
    range: MonthRange;
  }

  const MAX_CELL_LANES = 3;
  const MIN_LABEL_PX = 54;
  /** Air, in months, kept on both sides of a company window. */
  const WINDOW_PAD_MONTHS = 9;
  /** Minimum pixels between two year labels before they are thinned out. */
  const MIN_YEAR_SPACING_PX = 42;

  let stop: (() => void) | null = null;

  boot();

  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => {
    stop?.();
    stop = null;
  });

  function boot() {
    const host = document.querySelector<HTMLElement>("#matriz");
    if (!host || host.dataset.matrixReady === "true") return;
    stop?.();
    host.dataset.matrixReady = "true";
    stop = start(host);
  }

  function start(host: HTMLElement): () => void {
    const surface = must<HTMLElement>(".matrix-surface", host);
    const grid = must<HTMLElement>("#matrix-grid", host);
    const rangeLabel = must<HTMLElement>("#matrix-range", host);
    const note = must<HTMLElement>("#matrix-note", host);
    const tip = must<HTMLElement>("#matrix-tip", host);
    const dataScript = must<HTMLScriptElement>("#matrix-data", host);

    const payload = JSON.parse(dataScript.textContent ?? "{}") as Payload;
    const projects = payload.projects;

    /** A window on a company hides the rest of the path, not just its years. */
    function visibleProjects(): Project[] {
      if (state.window === null) return projects;
      return projects.filter(
        (project) => project.companyId === state.window,
      );
    }
    const positions = payload.positions;
    const projectById = new Map(projects.map((project) => [project.id, project]));
    const state = readState();
    let lastAxes = { x: "", y: "" };
    let measureCanvas: CanvasRenderingContext2D | null = null;

    bindChips();
    bindWindows();
    render();

    const observer = new ResizeObserver(() => measure());
    observer.observe(surface);

    return () => {
      observer.disconnect();
      hideTip();
    };

    function readState(): { x: AxisId; y: AxisId; window: string | null } {
      const params = new URLSearchParams(window.location.search);
      const rawY = params.get("y") ?? "";
      const rawWindow = params.get("w") ?? "";
      // The horizontal axis is always time; only the rows can be regrouped.
      const x: AxisId = "time";
      // Grouping by project would give one line per project, so it is not offered.
      const y =
        isAxisId(rawY) && rawY !== "project" && axesAreValid(x, rawY)
          ? rawY
          : "company";
      // One window at a time; older links may carry a list, so the first wins.
      const asked = rawWindow.split(",").filter(Boolean);
      const only =
        payload.companies.find((company) => asked.includes(company.id))?.id ?? null;
      return { x, y, window: only };
    }

    /** The real months of the selected companies, without the breathing room. */
    function windowSpan(windowId: string | null): MonthRange {
      if (windowId === null) return payload.range;
      const own = positions.filter(
        (position) => position.companyId === windowId,
      );
      if (own.length === 0) return payload.range;
      return {
        from: Math.min(...own.map((position) => position.startMonth)),
        to: Math.max(...own.map((position) => position.endMonth)),
      };
    }

    /**
     * Zooming to some companies gives the short stints room to be read, and a
     * few months on each side so a bar never starts or ends on the table edge.
     */
    function rangeFor(windowId: string | null): MonthRange {
      const span = windowSpan(windowId);
      if (windowId === null) return span;
      return {
        from: Math.max(payload.range.from, span.from - WINDOW_PAD_MONTHS),
        to: Math.min(payload.range.to, span.to + WINDOW_PAD_MONTHS),
      };
    }

    /** Drawing range: whole years, so every year line lands on a label. */
    function chartRange(range: MonthRange): MonthRange {
      return {
        from: Math.floor(range.from / 12) * 12,
        to: (Math.floor((range.to - 1) / 12) + 1) * 12,
      };
    }

    function bindChips() {
      for (const chip of host.querySelectorAll<HTMLButtonElement>(".chip")) {
        chip.addEventListener("click", () => {
          const axis = chip.dataset.axis;
          const value = chip.dataset.value ?? "";
          if ((axis !== "x" && axis !== "y") || !isAxisId(value)) return;
          if (!axesAreValid(value, axis === "x" ? state.y : state.x)) return;
          if (axis === "x") state.x = value;
          else state.y = value;
          render();
        });
      }
    }

    function bindWindows() {
      for (const chip of host.querySelectorAll<HTMLButtonElement>(".wchip")) {
        chip.addEventListener("click", () => {
          const value = chip.dataset.window ?? "";
          if (!value) return;
          // Only one at a time: tapping the active one leaves the whole path.
          state.window = state.window === value ? null : value;
          render();
        });
      }
    }


    function render() {
      const before = captureBars();
      const beforeHeight = surface.getBoundingClientRect().height;
      const axesChanged = lastAxes.x !== state.x || lastAxes.y !== state.y;
      const shown = visibleProjects();
      const range = rangeFor(state.window);
      const chart = chartRange(range);
      const chartSpan = chart.to - chart.from;
      const xValues = axisValues(state.x, projects, payload.config, range);
      const yValues = axisValues(state.y, shown, payload.config, range);

      grid.dataset.mode = state.x === "time" ? "timeline" : "matrix";
      grid.style.setProperty("--cols", String(xValues.length));
      // Fixed density: the width comes from the months, never from the panel.
      grid.style.setProperty("--months", String(chartSpan));
      grid.style.setProperty(
        "--year-step",
        `${((12 / Math.max(1, chartSpan)) * 100).toFixed(4)}%`,
      );
      grid.style.setProperty(
        "--quarter-step",
        `${((3 / Math.max(1, chartSpan)) * 100).toFixed(4)}%`,
      );
      grid.style.setProperty("--year-offset", "0%");
      grid.style.setProperty("--today", `${monthPct(nowMonth(), chart)}%`);

      const timeline = state.x === "time";
      grid.replaceChildren(
        timeline
          ? renderTimeline(yValues, shown, chart)
          : renderMatrix(xValues, yValues, chart),
      );
      note.hidden = timeline;

      lastAxes = { x: state.x, y: state.y };
      settle(before, axesChanged);

      const span = windowSpan(state.window);
      rangeLabel.textContent = `${monthLabel(span.from)} — ${monthLabel(span.to - 1)} · ${durationLabel(span.to - span.from)}`;

      syncChips();
      syncWindows();
      syncUrl();
      measure();
      requestAnimationFrame(() => {
        measure();
        glideHeight(beforeHeight);
      });
    }

    /**
     * Rows come and go when the grouping or the window changes; the table takes
     * its new height instead of snapping to it.
     */
    function glideHeight(from: number) {
      if (!from || from < 24) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const to = surface.getBoundingClientRect().height;
      if (Math.abs(to - from) < 1) return;
      surface.animate(
        [{ height: `${from}px` }, { height: `${to}px` }],
        { duration: 420, easing: "cubic-bezier(.22, 1, .36, 1)" },
      );
    }

    function captureBars(): Map<string, DOMRect> {
      const rects = new Map<string, DOMRect>();
      for (const bar of grid.querySelectorAll<HTMLElement>(".bar")) {
        rects.set(
          `${bar.dataset.project ?? ""}#${bar.dataset.span ?? "0"}`,
          bar.getBoundingClientRect(),
        );
      }
      return rects;
    }

    /**
     * Zooming to a stage moves the same bars into a narrower range, so they glide
     * from where they were to where they are. Changing an axis replaces what a
     * row means, so the grid cross-fades instead of pretending it kept its place.
     */
    function settle(before: Map<string, DOMRect>, axesChanged: boolean) {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      if (axesChanged) {
        grid.animate([{ opacity: 0.3 }, { opacity: 1 }], {
          duration: 220,
          easing: "ease-out",
        });
        return;
      }

      for (const bar of grid.querySelectorAll<HTMLElement>(".bar")) {
        const from = before.get(
          `${bar.dataset.project ?? ""}#${bar.dataset.span ?? "0"}`,
        );
        if (!from) continue;
        const now = bar.getBoundingClientRect();
        const dx = from.left - now.left;
        const dy = from.top - now.top;
        const sx = from.width / Math.max(1, now.width);
        const sy = from.height / Math.max(1, now.height);
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1 && Math.abs(sx - 1) < 0.03) {
          continue;
        }
        bar.animate(
          [
            {
              transformOrigin: "0 0",
              transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`,
              opacity: 0.55,
            },
            { transformOrigin: "0 0", transform: "none", opacity: 1 },
          ],
          { duration: 380, easing: "cubic-bezier(.22, 1, .36, 1)" },
        );
      }
    }

    function syncChips() {
      for (const chip of host.querySelectorAll<HTMLButtonElement>(".chip")) {
        const current = chip.dataset.axis === "x" ? state.x : state.y;
        const pressed = chip.dataset.value === current;
        chip.setAttribute("aria-pressed", String(pressed));
        const other = chip.dataset.axis === "x" ? state.y : state.x;
        const value = chip.dataset.value ?? "";
        const blocked = !pressed && (!isAxisId(value) || !axesAreValid(value, other));
        chip.setAttribute("aria-disabled", String(blocked));
      }
    }

    function syncWindows() {
      for (const chip of host.querySelectorAll<HTMLButtonElement>(".wchip")) {
        chip.setAttribute(
          "aria-pressed",
          String(chip.dataset.window === state.window),
        );
      }
    }


    function syncUrl() {
      const url = new URL(window.location.href);
      url.searchParams.set("x", state.x);
      url.searchParams.set("y", state.y);
      if (state.window === null) url.searchParams.delete("w");
      else url.searchParams.set("w", state.window);
      // ClientRouter keeps its navigation index in history.state: preserve it,
      // otherwise back/forward stop being handled after a filter change.
      if (url.href !== window.location.href) {
        window.history.replaceState(window.history.state, "", url);
      }
    }

    function makeBand(band: { leftPct: number; widthPct: number }): HTMLElement {
      const node = element("div", "band");
      node.setAttribute("aria-hidden", "true");
      node.style.setProperty("--left", String(band.leftPct));
      node.style.setProperty("--w", String(band.widthPct));
      return node;
    }

    function accentFor(axis: AxisId, value: string): string | null {
      const match = projects.find((project) => {
        if (axis === "company") return project.companyId === value;
        if (axis === "position") return positionKey(project) === value;
        if (axis === "project") return project.id === value;
        return false;
      });
      return match?.accent ?? null;
    }

    function nowMonth(): number {
      const now = new Date();
      return now.getFullYear() * 12 + now.getMonth() + 1;
    }

    function ruler(range: MonthRange, shown: Project[]): HTMLElement {
      const track = element("div", "ruler-track");
      track.style.gridColumn = "2 / -1";

      const firstYear = Math.floor(range.from / 12);
      const lastYear = Math.floor(Math.max(range.from, range.to - 1) / 12);

      for (let year = firstYear; year <= lastYear; year += 1) {
        const boundary = Math.max(year * 12, range.from);
        const label = element("span", "ruler-tick", String(year));
        label.dataset.tick = String(year);
        label.style.left = `${monthPct(boundary, range)}%`;
        if (boundary === range.from) label.style.transform = "none";
        track.append(label);
      }

      // The bottom of the ruler carries each company's range, so the years of a
      // stage are readable without tracing its rows.
      const spans = element("div", "ruler-spans");
      spans.setAttribute("aria-hidden", "true");
      for (const company of payload.companies) {
        const own = shown.filter((project) => project.companyId === company.id);
        if (own.length === 0) continue;
        const from = Math.max(Math.min(...own.map((item) => item.startMonth)), range.from);
        const to = Math.min(Math.max(...own.map((item) => item.endMonth)), range.to);
        if (to <= from) continue;
        const span = element("span", "ruler-span");
        span.dataset.accent = company.accent;
        const left = monthPct(from, range);
        span.style.setProperty("--l", left.toFixed(3));
        span.style.setProperty("--w", (monthPct(to, range) - left).toFixed(3));
        spans.append(span);
      }
      track.append(spans);

      // "hoy" only belongs on a window that reaches the present.
      if (range.to >= chartRange(payload.range).to) {
        const today = element("span", "ruler-today", "hoy");
        today.style.left = `${monthPct(nowMonth(), range)}%`;
        today.style.transform = "translateX(-100%)";
        track.append(today);
      }

      return track;
    }

    function renderTimeline(
      yValues: AxisValue[],
      shown: Project[],
      range: MonthRange,
    ): DocumentFragment {
      const fragment = document.createDocumentFragment();
      fragment.append(element("div", "ruler-corner"), ruler(range, shown));

      const rows = yValues.map((yValue) => ({
        yValue,
        bars: rowBars(shown, state.y, yValue.id, range),
      }));

      // The accent bar belongs to the company, not to the row: an unbroken run of
      // rows of the same company shares one gradient from its top to its bottom.
      const companyAt = (index: number) => {
        const first = rows[index]?.bars[0];
        return first ? (projectById.get(first.id)?.companyId ?? null) : null;
      };
      const runs = rows.map(() => ({ start: 0, length: 1 }));
      for (let start = 0; start < rows.length; ) {
        const key = companyAt(start);
        let end = start;
        while (key !== null && end + 1 < rows.length && companyAt(end + 1) === key) {
          end += 1;
        }
        for (let index = start; index <= end; index += 1) {
          runs[index] = { start, length: end - start + 1 };
        }
        start = end + 1;
      }

      for (const [index, { yValue, bars }] of rows.entries()) {
        // One line per project: the name sits outside the bar, so it needs room
        // of its own instead of being packed into shared lanes. A project keeps
        // its line when it draws several stints.
        const laneByProject = new Map<string, number>();
        const lanes = bars.map((bar) => {
          const known = laneByProject.get(bar.id);
          if (known !== undefined) return known;
          const lane = laneByProject.size;
          laneByProject.set(bar.id, lane);
          return lane;
        });
        const laneCount = Math.max(1, laneByProject.size);

        const row = element("div", "gantt-row");
        row.style.setProperty("--lanes", String(laneCount));
        const accent = accentFor(state.y, yValue.id);
        if (accent) row.dataset.accent = accent;

        const label = element("div", "row-label");
        label.title = yValue.label;
        label.append(nameNode(state.y, yValue, "row-name"));

        const run = runs[index];
        const from = (index - run.start) / run.length;
        label.style.setProperty("--fade-a", Math.max(0, 1 - from).toFixed(3));
        label.style.setProperty(
          "--fade-b",
          Math.max(0, 1 - from - 1 / run.length).toFixed(3),
        );

        const track = element("div", "track");
        // The band follows the bars themselves, so a role merged from several
        // stints covers the whole stretch it spans.
        const firstBar = bars[0];
        const lastBar = bars[bars.length - 1];
        if (firstBar && lastBar) {
          track.append(
            makeBand({
              leftPct: firstBar.leftPct,
              widthPct: lastBar.leftPct + lastBar.widthPct - firstBar.leftPct,
            }),
          );
        }
        const named = new Set<string>();
        for (const [lane, bar] of bars.entries()) {
          const project = projectById.get(bar.id);
          if (!project) continue;
          track.append(
            makeBar(project, bar, lanes[lane] ?? 0, !named.has(bar.id)),
          );
          named.add(bar.id);
        }

        row.append(label, track);
        fragment.append(row);
      }

      return fragment;
    }

    function renderMatrix(
      xValues: AxisValue[],
      yValues: AxisValue[],
      range: MonthRange,
    ): DocumentFragment {
      const fragment = document.createDocumentFragment();
      fragment.append(element("div", "head-corner"));

      for (const xValue of xValues) {
        const head = element("div", "col-head");
        const accent = accentFor(state.x, xValue.id);
        if (accent) head.style.setProperty("--head-accent", `var(--${accent})`);
        head.title = xValue.label;
        head.append(nameNode(state.x, xValue, "col-name"));
        fragment.append(head);
      }

      for (const yValue of yValues) {
        const label = element("div", "row-label");
        const accent = accentFor(state.y, yValue.id);
        if (accent) label.dataset.accent = accent;
        label.append(nameNode(state.y, yValue, "row-name"));
        label.title = yValue.label;
        fragment.append(label);
        for (const xValue of xValues) {
          fragment.append(makeCell(xValue, yValue, range));
        }
      }

      return fragment;
    }

    function makeCell(
      xValue: AxisValue,
      yValue: AxisValue,
      range: MonthRange,
    ): HTMLElement {
      const bars = cellBars(
        projects,
        state.x,
        xValue.id,
        state.y,
        yValue.id,
        range,
      );
      const lanes = packLanes(bars);
      const cell = element("div", "cell");

      const visible = bars.filter((_, index) => (lanes[index] ?? 0) < MAX_CELL_LANES);
      const visibleLanes = new Set(
        bars.flatMap((_, index) => {
          const lane = lanes[index] ?? 0;
          return lane < MAX_CELL_LANES ? [lane] : [];
        }),
      );

      cell.style.setProperty("--lanes", String(Math.max(1, visibleLanes.size)));

      for (const [index, bar] of bars.entries()) {
        if ((lanes[index] ?? 0) >= MAX_CELL_LANES) continue;
        const project = projectById.get(bar.id);
        if (project) cell.append(makeBar(project, bar, lanes[index] ?? 0));
      }

      const hidden = bars.length - visible.length;
      if (hidden > 0) {
        const more = element("button", "cell-more", `+${hidden}`);
        more.type = "button";
        more.title = `${bars.length} proyectos en ${xValue.label} × ${yValue.label}`;
        more.setAttribute("aria-label", more.title);
        more.addEventListener("click", () =>
          openDrawer({
            kind: "list",
            label: `${xValue.label} × ${yValue.label}`,
            ids: bars.map((bar) => bar.id),
            origin: more,
          }),
        );
        cell.append(more);
      }

      return cell;
    }

    function makeBar(
      project: Project,
      bar: Bar,
      lane: number,
      named = true,
    ): HTMLButtonElement {
      const button = element("button", "bar");
      button.type = "button";
      button.dataset.project = project.id;
      button.dataset.span = String(bar.span ?? 0);
      button.dataset.accent = project.accent;
      button.style.setProperty("--left", String(bar.leftPct));
      button.style.setProperty("--w", String(bar.widthPct));
      button.style.setProperty("--lane", String(lane));

      // The name goes once per project, on its first stint.
      if (named) button.append(element("span", "bar-label", project.short));
      button.setAttribute("aria-label", ariaFor(project, bar));

      button.addEventListener("click", () => {
        hideTip();
        clearHighlight();
        openDrawer({ kind: "project", id: project.id, origin: button });
      });
      button.addEventListener("mouseenter", (event) => {
        highlight(project.id);
        showTip(project, bar, event);
      });
      button.addEventListener("mousemove", (event) => placeTip(event));
      button.addEventListener("mouseleave", () => {
        clearHighlight();
        hideTip();
      });
      button.addEventListener("focus", () => {
        highlight(project.id);
        showTip(project, bar);
      });
      button.addEventListener("blur", () => {
        clearHighlight();
        hideTip();
      });

      return button;
    }

    function ariaFor(project: Project, bar: Bar): string {
      return `${project.name}, ${project.company}, ${spanLabel(bar.startMonth, bar.endMonth)}`;
    }

    function showTip(project: Project, bar: Bar, event?: MouseEvent) {
      tip.replaceChildren(
        element("span", "tip-title", project.name),
        element("span", "tip-meta", `${project.company} · ${project.position}`),
        element(
          "span",
          "tip-dates",
          `${spanLabel(bar.startMonth, bar.endMonth)} · ${durationLabel(bar.endMonth - bar.startMonth)}`,
        ),
      );
      tip.hidden = false;
      if (event) placeTip(event);
      else placeTipAtBar(bar);
    }

    function placeTipAtBar(bar: Bar) {
      const target = grid.querySelector<HTMLElement>(
        `.bar[data-project="${bar.id}"]`,
      );
      if (!target) return;
      const rect = target.getBoundingClientRect();
      position(rect.left + rect.width / 2, rect.bottom + 8);
    }

    function placeTip(event: MouseEvent) {
      position(event.clientX, event.clientY + 16);
    }

    function position(x: number, y: number) {
      const margin = 12;
      const width = tip.offsetWidth;
      const height = tip.offsetHeight;
      const left = Math.min(
        Math.max(margin, x - width / 2),
        window.innerWidth - width - margin,
      );
      const top = Math.min(y, window.innerHeight - height - margin);
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    }

    function hideTip() {
      tip.hidden = true;
    }

    function highlight(id: string) {
      for (const bar of grid.querySelectorAll<HTMLElement>(".bar")) {
        bar.classList.toggle("is-dim", bar.dataset.project !== id);
      }
    }

    function clearHighlight() {
      for (const bar of grid.querySelectorAll<HTMLElement>(".bar")) {
        bar.classList.remove("is-dim");
      }
    }

    function measure() {
      fitLabelColumn();
      if (grid.dataset.mode === "timeline") {
        measureOutsideLabels();
      } else {
        for (const bar of grid.querySelectorAll<HTMLElement>(".bar")) {
          const fits = bar.scrollWidth <= bar.clientWidth + 1;
          bar.classList.toggle("is-labeled", fits && bar.clientWidth >= MIN_LABEL_PX);
        }
      }

      // One stride for the year labels and their lines, so they line up.
      const chart = chartRange(rangeFor(state.window));
      const years = Math.max(1, (chart.to - chart.from) / 12);
      const sample =
        grid.querySelector<HTMLElement>(".track") ??
        grid.querySelector<HTMLElement>(".cell");
      const pxPerYear = sample ? sample.clientWidth / years : 0;
      const stride =
        pxPerYear > 0 ? Math.max(1, Math.ceil(MIN_YEAR_SPACING_PX / pxPerYear)) : 1;
      grid.style.setProperty(
        "--year-step",
        `${((100 / years) * stride).toFixed(4)}%`,
      );

      thinRuler(stride);
    }

    /** The stage column fits its longest name instead of a fixed 13rem. */
    function fitLabelColumn() {
      measureCanvas ??= document.createElement("canvas").getContext("2d");
      const sample = grid.querySelector<HTMLElement>(".row-name");
      if (!measureCanvas || !sample) return;
      const style = getComputedStyle(sample);
      measureCanvas.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const spacing = Number.parseFloat(style.letterSpacing);
      if (Number.isFinite(spacing)) {
        try {
          measureCanvas.letterSpacing = `${spacing}px`;
        } catch {
          // Older engines ignore letter spacing here; the slack below covers it.
        }
      }
      let widest = 0;
      for (const name of grid.querySelectorAll<HTMLElement>(".row-name")) {
        const label = name.textContent ?? "";
        const text = style.textTransform === "uppercase" ? label.toUpperCase() : label;
        widest = Math.max(widest, measureCanvas.measureText(text).width);
      }
      // Label padding on both sides plus a hair of slack, within sane bounds.
      const column = Math.ceil(widest + 30);
      host.style.setProperty(
        "--label-col",
        `${Math.min(208, Math.max(72, column))}px`,
      );
    }

    /**
     * The name lives outside the bar now: it stays on the right while there is
     * room, hops to the left when the bar ends near the edge, and only then hides.
     */
    function measureOutsideLabels() {
      const GAP = 6;
      for (const bar of grid.querySelectorAll<HTMLElement>(".bar")) {
        const label = bar.querySelector<HTMLElement>(".bar-label");
        const track = bar.closest(".track");
        if (!label || !track) continue;
        label.classList.remove("is-flipped", "is-hidden");
        const width = label.offsetWidth;
        const barBox = bar.getBoundingClientRect();
        const trackBox = track.getBoundingClientRect();
        if (barBox.right + GAP + width <= trackBox.right) continue;
        if (barBox.left - GAP - width >= trackBox.left) {
          label.classList.add("is-flipped");
        } else {
          label.classList.add("is-hidden");
        }
      }
    }

    /** Keeps the year ruler readable: drop labels that no longer fit. */
    function thinRuler(stride: number) {
      const labels = grid.querySelectorAll<HTMLElement>(".ruler-tick");
      if (labels.length === 0) return;
      const last = labels.length - 1;
      for (const [index, label] of [...labels].entries()) {
        const keep = index === 0 || (last - index) % stride === 0;
        label.classList.toggle("is-hidden", !keep);
      }
      dropCollisions();
    }

    /** A partial first year or the "hoy" mark can still crowd the ruler. */
    function dropCollisions() {
      const today = grid.querySelector<HTMLElement>(".ruler-today");
      const limit = today ? today.getBoundingClientRect().left - 4 : Infinity;
      let lastRight = Number.NEGATIVE_INFINITY;
      for (const label of grid.querySelectorAll<HTMLElement>(".ruler-tick")) {
        if (label.classList.contains("is-hidden")) continue;
        const box = label.getBoundingClientRect();
        if (box.left < lastRight + 4 || box.right > limit) {
          label.classList.add("is-hidden");
          continue;
        }
        lastRight = box.right;
      }
    }
  }

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  /**
   * A row or column name. On the company axis the name is a preview trigger:
   * its card is the one rendered once per company in the legend's foot.
   */
  function nameNode(
    axis: string,
    value: { id: string; label: string },
    className: string,
  ): HTMLElement {
    const name = element("span", className, value.label);
    if (axis !== "company") return name;
    const trigger = element("button", "preview-term", value.label);
    trigger.type = "button";
    // The same company can head a row and a column: the direction names them.
    trigger.id = `${className === "col-name" ? "preview-col" : "preview-row"}-${value.id}`;
    trigger.dataset.preview = value.id;
    trigger.setAttribute("aria-expanded", "false");
    name.replaceChildren(trigger);
    return name;
  }

  function must<T extends Element>(selector: string, parent: ParentNode): T {
    const node = parent.querySelector<T>(selector);
    if (!node) throw new Error(`matrix markup is missing ${selector}`);
    return node;
  }
</script>

