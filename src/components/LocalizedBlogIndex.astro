---
import Layout from "../layouts/Layout.astro";
import PostCard from "./PostCard.astro";
import {
  FEATURED_POST,
  OTHER_POSTS,
  POSTS,
  formatDateIn,
  postHrefIn,
} from "../data/blog";
import { SITE } from "../data/site";
import { PROFILE } from "../i18n/profile";
import { EDITORIAL } from "../i18n/editorial";
import {
  alternateEditorialPaths,
  type TranslatedLocale,
} from "../i18n/routing";

interface Props {
  lang: TranslatedLocale;
}

const { lang } = Astro.props;
const copy = EDITORIAL[lang].blog;
const featuredCopy = PROFILE[lang].posts[FEATURED_POST.slug];
const pageUrl = new URL(`/${lang}/blog/`, SITE.url).href;
const inLanguage = lang === "en" ? "en-GB" : "ca-ES";
const articles = "articles";
const latest = lang === "en" ? "Latest" : "Recents";
const fromProjects =
  lang === "en" ? "written from real projects" : "escrits des de projectes reals";

const jsonLd = [
  {
    "@type": "Blog",
    "@id": `${pageUrl}#blog`,
    url: pageUrl,
    name: copy.metaTitle,
    description: copy.metaDescription,
    inLanguage,
    author: { "@id": new URL("/#person", SITE.url).href },
    blogPost: POSTS.map((post) => ({
      "@type": "BlogPosting",
      headline: PROFILE[lang].posts[post.slug].title,
      url: new URL(postHrefIn(lang, post.slug), SITE.url).href,
      datePublished: post.date,
      dateModified: post.updated ?? post.date,
      author: { "@id": new URL("/#person", SITE.url).href },
    })),
  },
];
---

<Layout
  title={copy.metaTitle}
  description={copy.metaDescription}
  lang={lang}
  alternates={alternateEditorialPaths("/blog/")}
  jsonLd={jsonLd}
  breadcrumbs={[{ label: copy.eyebrow }]}
>
  <header class="page-head">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 class="display">{copy.title}</h1>
    <p class="lede">{copy.lede}</p>
    <div class="meta-row">
      <span>{POSTS.length} {articles}</span>
      <span>{fromProjects}</span>
    </div>
  </header>

  <section class="section" aria-labelledby="destacado-title">
    <div class="section-head">
      <h2 class="section-title" id="destacado-title">{copy.featured}</h2>
      <span class="section-meta">{formatDateIn(FEATURED_POST.date, lang)}</span>
    </div>
    <article class="featured-post">
      <div class="featured-body">
        <p class="eyebrow">{featuredCopy.category}</p>
        <h3 class="featured-title">
          <a href={postHrefIn(lang, FEATURED_POST.slug)}>{featuredCopy.title}</a>
        </h3>
        <p class="featured-text">{featuredCopy.description}</p>
        <div class="meta-row">
          <span>{formatDateIn(FEATURED_POST.date, lang)}</span>
          <span>{FEATURED_POST.readingMinutes} {EDITORIAL[lang].article.readingTime}</span>
        </div>
        <div class="tag-row">
          {EDITORIAL[lang].posts[FEATURED_POST.slug].tags.map((tag) => (
            <span class="pill">{tag}</span>
          ))}
        </div>
        <a class="btn btn--link" href={postHrefIn(lang, FEATURED_POST.slug)}>
          {copy.readArticle}
        </a>
      </div>
      <aside class="topics" aria-labelledby="temas-title">
        <h2 class="section-title" id="temas-title">{latest}</h2>
        <ul>
          {POSTS.map((post) => (
            <li>
              <a href={postHrefIn(lang, post.slug)}>
                <span>{PROFILE[lang].posts[post.slug].category}</span>
                <span class="topic-count">{formatDateIn(post.date, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </article>
  </section>

  <section class="section" aria-labelledby="articulos-title">
    <div class="section-head">
      <h2 class="section-title" id="articulos-title">{copy.allArticles}</h2>
      <span class="section-meta">{copy.newest}</span>
    </div>
    <div class="post-list">
      {OTHER_POSTS.map((post) => <PostCard post={post} lang={lang} />)}
      <PostCard post={FEATURED_POST} lang={lang} />
    </div>
  </section>

  <section class="closing" aria-labelledby="blog-cierre">
    <h2 class="section-title" id="blog-cierre">{copy.closingTitle}</h2>
    <p>{copy.closingBody}</p>
    <div class="actions">
      <a class="btn" href={`/${lang}/projects/`}>{copy.projectsCta}</a>
      <a class="btn btn--ghost" href={`/${lang}/#contacto`}>{copy.contactCta}</a>
    </div>
  </section>
</Layout>

<style>
  .section {
    display: grid;
  }

  .featured-post {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .featured-post {
      grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 1fr);
      gap: 3rem;
    }
  }

  .featured-body {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.6rem 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card);
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .featured-title a {
    text-decoration: none;
  }

  .featured-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 6px;
  }

  .featured-text {
    max-inline-size: 40rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }

  .topics {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .topics .section-title {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .topics ul {
    display: grid;
    gap: 0.15rem;
  }

  .topics a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .topics a:hover {
    color: var(--color-ink);
  }

  .topic-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-faint);
  }

  .post-list {
    display: grid;
  }

  .closing {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    padding: 1.75rem 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-paper-warm);
  }

  .closing p {
    max-inline-size: 38rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
