---
import Layout from "../layouts/Layout.astro";
import AutoPreviews from "./AutoPreviews.astro";
import HeroWheel from "./HeroWheel.astro";
import { COMPANIES, POSITION_VIEWS, PROJECTS } from "../data/cv";
import { FEATURED_CASE, SELECTED_CASES } from "../data/projects";
import { SORTED_POSTS, postHrefIn } from "../data/blog";
import { SITE } from "../data/site";
import { PROFILE } from "../i18n/profile";
import {
	alternateProfilePaths,
	type TranslatedLocale,
} from "../i18n/routing";
import { spanLabelIn } from "../lib/period";

interface Props {
	lang: TranslatedLocale;
}

const { lang } = Astro.props;
const copy = PROFILE[lang];

const caseHref = (href: string) => `/${lang}${href}`;
const postHref = (slug: string) => postHrefIn(lang, slug);

const pageUrl = new URL(`/${lang}/`, SITE.url).href;
const jsonLd = [
	{
		"@type": "ProfilePage",
		"@id": `${pageUrl}#webpage`,
		url: pageUrl,
		name: copy.metaTitle,
		description: copy.metaDescription,
		inLanguage: lang,
		about: { "@id": new URL("/#person", SITE.url).href },
		mainEntity: { "@id": new URL("/#person", SITE.url).href },
	},
];

const stages = COMPANIES.map((company) => {
	const own = POSITION_VIEWS.filter(
		(position) => position.companyId === company.id,
	).sort((a, b) => a.startMonth - b.startMonth);
	const from = Math.min(...own.map((position) => position.startMonth));
	const to = Math.max(...own.map((position) => position.endMonth));
	return {
		company,
		period: spanLabelIn(from, to, lang),
		copy: copy.experience.stages[company.id],
	};
}).filter((stage) => stage.copy);

const selected = [FEATURED_CASE, ...SELECTED_CASES.slice(0, 2)];

const dateFormat = new Intl.DateTimeFormat(lang, {
	day: "numeric",
	month: "short",
	year: "numeric",
	timeZone: "UTC",
});
const formatDate = (iso: string) =>
	dateFormat.format(new Date(`${iso}T00:00:00Z`));
---

<Layout
  title={copy.metaTitle}
  description={copy.metaDescription}
  lang={lang}
  type="profile"
  jsonLd={jsonLd}
  alternates={alternateProfilePaths()}
>
  <header id="localized-profile-hero" class="profile-hero" aria-labelledby="profile-title">
    <p id="localized-profile-hero-eyebrow" class="eyebrow">{copy.eyebrow}</p>
    <HeroWheel
      titleId="profile-title"
      stem={copy.heroStem}
      lines={[copy.heroTitle]}
      words={copy.heroWords}
    />
    <p id="localized-profile-hero-lede" class="lede">{copy.heroLede}</p>
    <div id="localized-profile-hero-actions" class="actions">
      <a id="localized-profile-actions-btn" class="btn" href="#proyectos">{copy.ctaProjects}</a>
      <a id="localized-profile-actions-btn-2" class="btn btn--ghost" href="#cv">{copy.ctaCv}</a>
      <a id="localized-profile-actions-btn-3" class="btn btn--link" href="#contacto">{copy.ctaContact}</a>
    </div>
    <div id="localized-profile-hero-meta-row" class="meta-row">
      <span id="localized-profile-meta-row-is-available" class="is-available">{copy.availability}</span>
      <span id="localized-profile-meta-row-span">{copy.location}</span>
      <span id="localized-profile-meta-row-span-2">{PROJECTS.length} {copy.metaProjects}</span>
      <span id="localized-profile-meta-row-span-3">{copy.metaSince}</span>
    </div>
  </header>

  <section class="section" id="sobre" aria-labelledby="sobre-title">
    <div id="localized-profile-section-head" class="section-head">
      <h2 class="section-title" id="sobre-title">{copy.about.title}</h2>
      <span id="localized-profile-section-head-meta" class="section-meta">{copy.about.lede}</span>
    </div>
    <div id="localized-profile-section-about" class="profile-about">
      {
        copy.about.paragraphs.map((paragraph, i) => (
          <p id={`localized-profile-about-p-${i}`}>
            <AutoPreviews inline id={`localized-profile-about-${i}-prose`} text={paragraph} />
          </p>
        ))
      }
    </div>
  </section>

  <section class="section" id="especialidades" aria-labelledby="especialidades-title">
    <div id="localized-profile-section-head-2" class="section-head">
      <h2 class="section-title" id="especialidades-title">{copy.expertise.title}</h2>
      <span id="localized-profile-section-head-meta-2" class="section-meta">{copy.expertise.meta}</span>
    </div>
    <div id="localized-profile-section-grid" class="grid grid--4">
      {
        copy.expertise.items.map((item, i2) => (
          <div id={`localized-profile-grid-card-${i2}`} class="card">
            <h3 id={`localized-profile-card-h3-${i2}`}>{item.title}</h3>
            <p id={`localized-profile-card-p-${i2}`}>
              <AutoPreviews inline id={`localized-profile-expertise-${i2}-prose`} text={item.body} />
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" id="proyectos" aria-labelledby="proyectos-title">
    <div id="localized-profile-section-head-3" class="section-head">
      <h2 class="section-title" id="proyectos-title">{copy.selected.title}</h2>
      <span id="localized-profile-section-head-meta-3" class="section-meta">{copy.selected.meta}</span>
    </div>
    <div id="localized-profile-section-projects" class="profile-projects">
      {
        selected.map((project, index) => {
          const projectCopy = copy.projects[project.id];
          if (!projectCopy) return null;
          return (
            <article id={`localized-profile-projects-article-${index}`} class:list={["project", { "is-featured": index === 0 }]}>
              <div id={`localized-profile-projects-project-head-${index}`} class="project-head">
                <p id={`localized-profile-project-head-eyebrow-${index}`} class="eyebrow">{projectCopy.area}</p>
                <h3 id={`localized-profile-project-head-h3-${index}`}>
                  {project.caseStudyHref ? (
                    <a id={`localized-profile-project-head-a-${index}`} href={caseHref(project.caseStudyHref)}>
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                </h3>
                <p id={`localized-profile-project-head-meta-${index}`} class="project-meta">
                  {project.company} · {projectCopy.role}
                </p>
              </div>
              <p id={`localized-profile-projects-project-problem-${index}`} class="project-problem">
                <AutoPreviews inline id={`localized-profile-problem-${index}-prose`} text={projectCopy.problem} />
              </p>
              <dl id={`localized-profile-projects-facts-${index}`} class="facts">
                <dt id={`localized-profile-facts-dt-${index}`}>{copy.selected.role}</dt>
                <dd id={`localized-profile-facts-dd-${index}`}>{projectCopy.role}</dd>
                <dt id={`localized-profile-facts-dt-2-${index}`}>{copy.selected.decision}</dt>
                <dd id={`localized-profile-facts-dd-2-${index}`}>{projectCopy.decision}</dd>
                <dt id={`localized-profile-facts-dt-3-${index}`}>{copy.selected.outcome}</dt>
                <dd id={`localized-profile-facts-dd-3-${index}`}>{projectCopy.outcome}</dd>
              </dl>
              {project.stack && project.stack.length > 0 && (
                <div id={`localized-profile-projects-tag-row-${index}`} class="tag-row">
                  {project.stack.slice(0, 6).map((item, i3) => (
                    <span id={`localized-profile-tag-row-pill-${index}-${index}-${index}-${i3}`} class="pill">{item}</span>
                  ))}
                </div>
              )}
              {project.caseStudyHref && (
                <a id={`localized-profile-projects-project-link-${index}`} class="project-link" href={caseHref(project.caseStudyHref)}>
                  {copy.selected.readCase} <span id={`localized-profile-project-link-span-${index}`} aria-hidden="true">→</span>
                </a>
              )}
            </article>
          );
        })
      }
    </div>
    <p id="localized-profile-section-note" class="profile-note">
      <AutoPreviews inline id="localized-profile-selected-note-prose" text={copy.selected.note} />
    </p>
    <div id="localized-profile-section-actions" class="actions">
      <a id="localized-profile-actions-btn-4" class="btn btn--ghost" href={`/${lang}/projects/`}>{copy.selected.allProjects}</a>
    </div>
  </section>

  <section class="section" id="experiencia" aria-labelledby="experiencia-title">
    <div id="localized-profile-section-head-4" class="section-head">
      <h2 class="section-title" id="experiencia-title">{copy.experience.title}</h2>
      <span id="localized-profile-section-head-meta-4" class="section-meta">{copy.experience.meta}</span>
    </div>
    <ol id="localized-profile-section-stages" class="profile-stages">
      {
        stages.map((stage, i4) => (
          <li id={`localized-profile-stages-li-${i4}`} class:list={["profile-stage", `accent-${stage.company.accent}`]}>
            <div id={`localized-profile-stages-stage-head-${i4}`} class="profile-stage-head">
              <h3 id={`localized-profile-stage-head-h3-${i4}`}>{stage.company.name}</h3>
              <span id={`localized-profile-stage-head-span-${i4}`}>{stage.period}</span>
            </div>
            <p id={`localized-profile-stages-stage-roles-${i4}`} class="profile-stage-roles">{stage.copy?.roles}</p>
            <p id={`localized-profile-stages-stage-focus-${i4}`} class="profile-stage-focus">
              <AutoPreviews inline id={`localized-profile-stage-${i4}-prose`} text={stage.copy?.focus ?? ""} />
            </p>
          </li>
        ))
      }
    </ol>
    <p id="localized-profile-section-note-2" class="profile-note">
      <AutoPreviews inline id="localized-profile-experience-note-prose" text={copy.experience.note} />
    </p>
    <div id="localized-profile-section-actions-2" class="actions">
      <a id="localized-profile-actions-btn-5" class="btn btn--ghost" href="/experience/">{copy.experience.fullCareer}</a>
    </div>
  </section>

  <section class="section" id="blog" aria-labelledby="blog-title">
    <div id="localized-profile-section-head-5" class="section-head">
      <h2 class="section-title" id="blog-title">{copy.writing.title}</h2>
      <span id="localized-profile-section-head-meta-5" class="section-meta">{copy.writing.meta}</span>
    </div>
    <div id="localized-profile-section-posts" class="profile-posts">
      {
        SORTED_POSTS.map((post, i5) => {
          const postCopy = copy.posts[post.slug];
          if (!postCopy) return null;
          return (
            <article id={`localized-profile-posts-post-${i5}`} class="profile-post">
              <p id={`localized-profile-post-kicker-${i5}`} class="profile-post-kicker">
                <span id={`localized-profile-post-kicker-span-${i5}`}>{postCopy.category}</span>
                <span id={`localized-profile-post-kicker-span-2-${i5}`} aria-hidden="true">·</span>
                <time id={`localized-profile-post-kicker-time-${i5}`} datetime={post.date}>{formatDate(post.date)}</time>
              </p>
              <h3 id={`localized-profile-post-h3-${i5}`}>
                <a id={`localized-profile-post-a-${i5}`} href={postHref(post.slug)}>{postCopy.title}</a>
              </h3>
              <p id={`localized-profile-post-p-${i5}`}>{postCopy.description}</p>
              <a id={`localized-profile-post-project-link-${i5}`} class="project-link" href={postHref(post.slug)}>
                {copy.writing.read} <span id={`localized-profile-project-link-span-2-${i5}`} aria-hidden="true">→</span>
              </a>
            </article>
          );
        })
      }
    </div>
    <p id="localized-profile-section-note-3" class="profile-note">{copy.writing.note}</p>
  </section>

  <section class="section" id="servicios" aria-labelledby="servicios-title">
    <div id="localized-profile-section-head-6" class="section-head">
      <h2 class="section-title" id="servicios-title">{copy.services.title}</h2>
      <span id="localized-profile-section-head-meta-6" class="section-meta">{copy.services.meta}</span>
    </div>
    <div id="localized-profile-section-grid-2" class="grid grid--2">
      {
        copy.services.items.map((item, i6) => (
          <div id={`localized-profile-grid-card-2-${i6}`} class="card">
            <h3 id={`localized-profile-card-h3-2-${i6}`}>{item.title}</h3>
            <p id={`localized-profile-card-p-2-${i6}`}>{item.body}</p>
          </div>
        ))
      }
    </div>
    <p id="localized-profile-section-note-4" class="profile-note">{copy.services.note}</p>
  </section>

  <section class="section" id="cv" aria-labelledby="cv-title">
    <div id="localized-profile-section-head-7" class="section-head">
      <h2 class="section-title" id="cv-title">{copy.cv.title}</h2>
      <span id="localized-profile-section-head-meta-7" class="section-meta">{copy.cv.meta}</span>
    </div>
    <div id="localized-profile-section-cv" class="profile-cv">
      <p id="localized-profile-cv-lede" class="lede">{copy.cv.lede}</p>
      <ul id="localized-profile-cv-ul">
        {copy.cv.points.map((point, i7) => <li id={`localized-profile-cv-li-${i7}`}>{point}</li>)}
      </ul>
      <p id="localized-profile-cv-note" class="profile-note">{copy.cv.note}</p>
      <div id="localized-profile-cv-actions" class="actions">
        <a id="localized-profile-actions-btn-6" class="btn" href="/cv/" hreflang="es">{copy.cv.cta}</a>
      </div>
    </div>
  </section>

  <section class="section" id="contacto" aria-labelledby="contacto-title">
    <div id="localized-profile-section-head-8" class="section-head">
      <h2 class="section-title" id="contacto-title">{copy.contact.title}</h2>
      <span id="localized-profile-section-head-meta-8" class="section-meta">{copy.contact.meta}</span>
    </div>
    <p id="localized-profile-section-lede" class="profile-lede">{copy.contact.lede}</p>
    <div id="localized-profile-section-channels" class="profile-channels">
      <a id="localized-profile-channels-channel" class="profile-channel profile-channel--primary" href={`mailto:${SITE.email}`}>
        <span id="localized-profile-channel-label" class="profile-channel-label">{copy.contact.emailLabel}</span>
        <span id="localized-profile-channel-value" class="profile-channel-value">{SITE.email}</span>
        <span id="localized-profile-channel-note" class="profile-channel-note">{copy.contact.emailNote}</span>
      </a>
      {
        SITE.socials.map((social, i8) => (
          <a id={`localized-profile-channels-channel-2-item-${i8}`} class="profile-channel" href={social.href} rel="me">
            <span id={`localized-profile-channel-label-2-item-${i8}`} class="profile-channel-label">{social.label}</span>
            <span id={`localized-profile-channel-value-2-item-${i8}`} class="profile-channel-value">
              {social.href.replace("https://", "")}
            </span>
            <span id={`localized-profile-channel-note-2-item-${i8}`} class="profile-channel-note">
              {social.label === "GitHub"
                ? copy.contact.githubNote
                : copy.contact.socialNote}
            </span>
          </a>
        ))
      }
      <a id="localized-profile-channels-channel-2" class="profile-channel" href="/cv/" hreflang="es">
        <span id="localized-profile-channel-label-2" class="profile-channel-label">{copy.contact.cvLabel}</span>
        <span id="localized-profile-channel-value-2" class="profile-channel-value">{copy.contact.cvValue}</span>
        <span id="localized-profile-channel-note-2" class="profile-channel-note">{copy.contact.cvNote}</span>
      </a>
    </div>
    <div id="localized-profile-section-closing" class="profile-closing">
      <h3 id="localized-profile-closing-h3">{copy.contact.closingTitle}</h3>
      <p id="localized-profile-closing-p">{copy.contact.closingBody}</p>
      <div id="localized-profile-closing-actions" class="actions">
        <a id="localized-profile-actions-btn-7" class="btn" href={`mailto:${SITE.email}`}>{copy.contact.emailLabel}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
	.profile-hero {
		display: grid;
		gap: 1.1rem;
		max-inline-size: 58rem;
		padding-block: 1rem 0.5rem;
	}

	.profile-hero .eyebrow {
		color: var(--color-terracotta);
	}

	.profile-about {
		display: grid;
		gap: 1rem;
		max-inline-size: 48rem;
		color: var(--color-ink-muted);
	}

	.profile-about p {
		line-height: 1.8;
	}

	.profile-note,
	.profile-lede {
		max-inline-size: 48rem;
		color: var(--color-ink-muted);
	}

	.profile-note {
		margin-top: 1rem;
		font-size: 0.75rem;
		line-height: 1.7;
		color: var(--color-ink-faint);
	}

	.profile-lede {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.profile-projects {
		display: grid;
		gap: 1.25rem;
	}

	.project {
		display: grid;
		gap: 0.85rem;
		padding: 1.4rem 1.5rem 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: color-mix(in srgb, var(--color-card) 70%, transparent);
	}

	.project.is-featured {
		padding: 1.75rem 1.9rem;
		background: var(--color-card);
	}

	.project-head {
		display: grid;
		gap: 0.35rem;
	}

	.project-head h3 {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 500;
		line-height: 1.25;
	}

	.project.is-featured .project-head h3 {
		font-size: 1.7rem;
	}

	.project-head h3 a {
		text-decoration: none;
	}

	.project-head h3 a:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 5px;
	}

	.project-meta {
		font-family: var(--font-mono);
		font-size: 0.656rem;
		color: var(--color-ink-faint);
	}

	.project-problem {
		max-inline-size: 44rem;
		font-size: 0.875rem;
		line-height: 1.75;
		color: var(--color-ink-muted);
	}

	.project .facts {
		padding-block: 0.65rem;
		border-block: 1px solid var(--color-border-subtle);
	}

	.project-link {
		justify-self: start;
		font-size: 0.75rem;
		color: var(--color-ink);
		text-decoration: none;
	}

	.project-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.profile-stages {
		display: grid;
		border-top: 1px solid var(--color-border-subtle);
	}

	.profile-stage {
		display: grid;
		gap: 0.25rem;
		padding: 1.1rem 0.1rem 1.1rem 1rem;
		border-bottom: 1px solid var(--color-border-subtle);
		border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.profile-stage-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
	}

	.profile-stage-head h3 {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 500;
	}

	.profile-stage-head span {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-ink-faint);
	}

	.profile-stage-roles {
		font-size: 0.78125rem;
		line-height: 1.6;
		color: var(--color-ink-muted);
	}

	.profile-stage-focus {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--accent);
	}

	.profile-posts {
		display: grid;
		gap: 0;
	}

	.profile-post {
		display: grid;
		gap: 0.45rem;
		padding-block: 1.1rem;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.profile-post-kicker {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-ink-faint);
	}

	.profile-post h3 {
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.profile-post h3 a {
		text-decoration: none;
	}

	.profile-post h3 a:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 4px;
	}

	.profile-post > p:not(.profile-post-kicker) {
		font-size: 0.8125rem;
		line-height: 1.7;
		color: var(--color-ink-muted);
	}

	.profile-cv {
		display: grid;
		gap: 1rem;
		max-inline-size: 48rem;
	}

	.profile-cv ul {
		display: grid;
		gap: 0.45rem;
		padding-inline-start: 1.1rem;
		list-style: none;
	}

	.profile-cv li {
		position: relative;
		padding-inline-start: 0.85rem;
		font-size: 0.8125rem;
		line-height: 1.65;
		color: var(--color-ink-muted);
	}

	.profile-cv li::before {
		content: "";
		position: absolute;
		inset-inline-start: 0;
		inset-block-start: 0.72em;
		inline-size: 0.35rem;
		block-size: 1px;
		background: var(--color-ink-faint);
	}

	.profile-channels {
		display: grid;
		gap: 0.9rem;
	}

	@media (min-width: 768px) {
		.profile-channels {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.profile-channel {
		display: grid;
		gap: 0.25rem;
		padding: 1.15rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: color-mix(in srgb, var(--color-card) 70%, transparent);
		text-decoration: none;
	}

	.profile-channel:hover {
		border-color: color-mix(in srgb, var(--color-ink) 22%, transparent);
		background: var(--color-card);
	}

	.profile-channel--primary {
		border-inline-start: 2px solid var(--color-ink);
	}

	.profile-channel-label {
		font-family: var(--font-mono);
		font-size: 0.625rem;
