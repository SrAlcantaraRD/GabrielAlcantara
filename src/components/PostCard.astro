---
import type { PostMeta } from "../data/blog";
import { categoryOf, formatDateIn, postHref, postHrefIn } from "../data/blog";
import { PROFILE } from "../i18n/profile";
import type { Locale } from "../i18n/routing";
import { EDITORIAL } from "../i18n/editorial";

interface Props {
  post: PostMeta;
  /** Compact variant for sidebars and related lists. */
  compact?: boolean;
  /** Language of the card; Spanish is the default for the original pages. */
  lang?: Locale;
}

const { post, compact = false, lang = "es" } = Astro.props;
const category = categoryOf(post.category);
const localized = lang === "es" ? undefined : PROFILE[lang].posts[post.slug];
const editorial = lang === "es" ? undefined : EDITORIAL[lang];
const title = localized?.title ?? post.title;
const description = localized?.description ?? post.description;
const categoryLabel = localized?.category ?? category.label;
const tags = tagsFor(lang, post);
const href = postHrefIn(lang, post.slug);
const categoryHref =
  lang === "es" ? `/blog/categoria/${category.slug}/` : undefined;
const readingLabel = editorial?.article.readingTime ?? "min de lectura";

function tagsFor(locale: Locale, item: PostMeta): string[] {
  if (locale === "es") return item.tags;
  return EDITORIAL[locale].posts[item.slug]?.tags ?? item.tags;
}
---

<article class:list={["post-card", { "is-compact": compact }]}>
  <p class="post-kicker">
    {categoryHref ? (
      <a href={categoryHref}>{categoryLabel}</a>
    ) : (
      <span>{categoryLabel}</span>
    )}
    <span aria-hidden="true">·</span>
    <time datetime={post.date}>{formatDateIn(post.date, lang)}</time>
    <span aria-hidden="true">·</span>
    <span>{post.readingMinutes} {readingLabel}</span>
  </p>

  <h3 class="post-title">
    <a href={href}>{title}</a>
  </h3>

  {!compact && <p class="post-description">{description}</p>}

  {!compact && (
    <div class="tag-row">
      {tags.map((tag) => <span class="pill">{tag}</span>)}
    </div>
  )}
</article>

<style>
  .post-card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding-block: 0.2rem 1.15rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }

  .post-kicker a {
    color: var(--color-terracotta);
    text-decoration: none;
  }

  .post-kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .post-title a {
    text-decoration: none;
  }

  .post-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
  }

  .post-description {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .is-compact .post-title {
    font-size: 1.05rem;
  }
</style>
