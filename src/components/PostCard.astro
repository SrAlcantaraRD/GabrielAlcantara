---
import type { PostMeta } from "../data/blog";
import { categoryOf, formatShortDateIn, postHrefIn } from "../data/blog";
import { PROFILE } from "../i18n/profile";
import type { Locale } from "../i18n/routing";
import { EDITORIAL } from "../i18n/editorial";

interface Props {
  post: PostMeta;
  /** Compact variant for sidebars and related lists. */
  compact?: boolean;
  /** Language of the card; Spanish is the default for the original pages. */
  lang?: Locale;
}

const { post, compact = false, lang = "es" } = Astro.props;
const suffix = `-${post.slug}`;
const category = categoryOf(post.category);
const localized = lang === "es" ? undefined : PROFILE[lang].posts[post.slug];
const editorial = lang === "es" ? undefined : EDITORIAL[lang];
const title = localized?.title ?? post.title;
const description = localized?.description ?? post.description;
const categoryLabel = localized?.category ?? category.label;
const tags = tagsFor(lang, post);
const href = postHrefIn(lang, post.slug);
const categoryHref =
  lang === "es" ? `/blog/categoria/${category.slug}/` : undefined;
const readingLabel = editorial?.article.readingTimeShort ?? "min";

function tagsFor(locale: Locale, item: PostMeta): string[] {
  if (locale === "es") return item.tags;
  return EDITORIAL[locale].posts[item.slug]?.tags ?? item.tags;
}
---

<article id={`post-card-article${suffix}`} class:list={["post-card", { "is-compact": compact }]}>
  <p id={`post-card-kicker${suffix}`} class="post-kicker">
    {categoryHref ? (
      <a id={`post-card-kicker-a${suffix}`} href={categoryHref}>{categoryLabel}</a>
    ) : (
      <span id={`post-card-kicker-span${suffix}`}>{categoryLabel}</span>
    )}
    <span id={`post-card-kicker-span-2${suffix}`} aria-hidden="true">·</span>
    {/*
      Three facts on one line: the date is the one that shortens, because the
      card shares its column with the category and the reading time. The article
      itself keeps the long form.
    */}
    <time id={`post-card-kicker-time${suffix}`} datetime={post.date}>{formatShortDateIn(post.date, lang)}</time>
    <span id={`post-card-kicker-span-3${suffix}`} aria-hidden="true">·</span>
    <span id={`post-card-kicker-span-4${suffix}`}>{post.readingMinutes} {readingLabel}</span>
  </p>

  <h3 id={`post-card-title${suffix}`} class="post-title">
    <a id={`post-card-title-a${suffix}`} href={href}>{title}</a>
  </h3>

  {!compact && <p id={`post-card-description${suffix}`} class="post-description">{description}</p>}

  {!compact && (
    <div id={`post-card-tag-row${suffix}`} class="tag-row">
      {tags.map((tag, i) => <span id={`post-card-tag-row-pill-${i}${suffix}`} class="pill">{tag}</span>)}
    </div>
  )}
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding-block: 0.2rem 1.15rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /*
   * The whole card opens the article: the title's cover is the target, so the
   * top of the card is not a 25 px text box. The category keeps its own link,
   * lifted above the cover so it still reaches its page.
   */
  .post-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-kicker a {
    position: relative;
    z-index: 1;
  }

  .post-card:hover .post-title a {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
  }

  .post-card:has(.post-title a:focus-visible) {
    outline: 2px solid var(--color-cobalt);
    outline-offset: 2px;
  }

  .post-card:has(.post-title a:focus-visible) .post-title a {
    outline: none;
  }

  .post-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }

  .post-kicker a {
    color: var(--color-terracotta);
    text-decoration: none;
  }

  .post-kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .post-title a {
    text-decoration: none;
  }

  .post-description {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .is-compact .post-title {
    font-size: 1.05rem;
  }
</style>
