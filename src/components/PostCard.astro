---
import type { PostMeta } from "../data/blog";
import { categoryOf, formatDate, postHref } from "../data/blog";

interface Props {
  post: PostMeta;
  /** Compact variant for sidebars and related lists. */
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const category = categoryOf(post.category);
---

<article class:list={["post-card", { "is-compact": compact }]}>
  <p class="post-kicker">
    <a href={`/blog/categoria/${category.slug}/`}>{category.label}</a>
    <span aria-hidden="true">·</span>
    <time datetime={post.date}>{formatDate(post.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{post.readingMinutes} min de lectura</span>
  </p>

  <h3 class="post-title">
    <a href={postHref(post.slug)}>{post.title}</a>
  </h3>

  {!compact && <p class="post-description">{post.description}</p>}

  {!compact && (
    <div class="tag-row">
      {post.tags.map((tag) => <span class="pill">{tag}</span>)}
    </div>
  )}
</article>

<style>
  .post-card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding-block: 0.2rem 1.15rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }

  .post-kicker a {
    color: var(--color-terracotta);
    text-decoration: none;
  }

  .post-kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .post-title a {
    text-decoration: none;
  }

  .post-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
  }

  .post-description {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .is-compact .post-title {
    font-size: 1.05rem;
  }
</style>
