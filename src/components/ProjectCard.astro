---
import type { ProjectCase } from "../data/projects";
import { spanLabelIn } from "../lib/period";
import { PROFILE } from "../i18n/profile";
import { EDITORIAL } from "../i18n/editorial";
import type { Locale } from "../i18n/routing";

interface Props {
  project: ProjectCase;
  /** Drops the decision line on dense lists. */
  brief?: boolean;
  lang?: Locale;
}

const { project, brief = false, lang = "es" } = Astro.props;
const copy = lang === "es" ? undefined : PROFILE[lang].projects[project.id];
const area = copy?.area ?? project.area;
const role = copy?.role ?? project.role;
const problem = copy?.problem ?? project.problem;
const decision = copy?.decision ?? project.decision;
const outcome = copy?.outcome ?? project.outcome;
const href = project.caseStudyHref
  ? lang === "es"
    ? project.caseStudyHref
    : `/${lang}${project.caseStudyHref}`
  : undefined;
const labels =
  lang === "es"
    ? { role: "Rol", decision: "Decisión", outcome: "Resultado", case: "Ver el caso de estudio" }
    : {
        role: EDITORIAL[lang].case.role,
        decision: lang === "en" ? "Decision" : "Decisió",
        outcome: lang === "en" ? "Outcome" : "Resultat",
        case: lang === "en" ? "Read the case study" : "Llegir el cas d'estudi",
      };
---

<article class:list={["project-card", { "is-featured": project.featured }]}>
  <p class="project-area">{area}</p>

  <h3 class="project-name">
    {href ? <a href={href}>{project.name}</a> : project.name}
  </h3>

  <p class="project-meta">
    {project.company} · {spanLabelIn(project.startMonth, project.endMonth, lang)}
  </p>

  <p class="project-problem">{problem}</p>

  <dl class="project-facts">
    <div>
      <dt>{labels.role}</dt>
      <dd>{role}</dd>
    </div>
    {!brief && (
      <div>
        <dt>{labels.decision}</dt>
        <dd>{decision}</dd>
      </div>
    )}
    <div>
      <dt>{labels.outcome}</dt>
      <dd>{outcome}</dd>
    </div>
  </dl>

  {project.stack && project.stack.length > 0 && (
    <div class="tag-row">
      {project.stack.slice(0, 6).map((item) => <span class="pill">{item}</span>)}
    </div>
  )}

  {href && (
    <a class="project-link" href={href}>
      {labels.case}
      <span aria-hidden="true">→</span>
    </a>
  )}
</article>

<style>
  .project-card {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    padding: 1.4rem 1.5rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-card) 70%, transparent);
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--color-ink) 20%, transparent);
    background: var(--color-card);
  }

  .project-area {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-terracotta);
  }

  .project-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .project-name a {
    text-decoration: none;
  }

  .project-name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 4px;
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 0.656rem;
    color: var(--color-ink-faint);
  }

  .project-problem {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .project-facts {
    display: grid;
    gap: 0.55rem;
    margin-block: 0.1rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--color-border-subtle);
  }

  .project-facts div {
    display: grid;
    gap: 0.1rem;
  }

  .project-facts dt {
    font-family: var(--font-mono);
    font-size: 0.594rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .project-facts dd {
    margin: 0;
    font-size: 0.78125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .project-link {
    justify-self: start;
    font-size: 0.75rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .project-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .is-featured {
    padding: 1.75rem 1.9rem 1.9rem;
    background: var(--color-card);
  }

  .is-featured .project-name {
    font-size: 1.6rem;
  }

  .is-featured .project-problem {
    font-size: 0.875rem;
  }
</style>
