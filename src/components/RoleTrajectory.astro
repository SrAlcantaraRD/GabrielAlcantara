---
import {
	COMPANIES,
	PILLAR_LABEL,
	POSITION_VIEWS,
	PROJECTS,
	type PositionView,
} from "../data/cv";
import { PREVIEW_BY_STACK_LABEL } from "../data/previews";
import PreviewTerm from "./PreviewTerm.astro";
import AutoPreviews from "./AutoPreviews.astro";
import { durationLabel, spanLabel } from "../lib/period";

interface Group {
	id: string;
	company: string;
	short: string;
	accent: string;
	from: number;
	to: number;
	months: number;
	positions: {
		position: PositionView;
		projects: typeof PROJECTS;
	}[];
}

const groups: Group[] = COMPANIES.map((company) => {
	const own = POSITION_VIEWS.filter(
		(position) => position.companyId === company.id,
	).sort((a, b) => b.startMonth - a.startMonth);
	const from = Math.min(...own.map((position) => position.startMonth));
	const to = Math.max(...own.map((position) => position.endMonth));
	return {
		id: company.id,
		company: company.name,
		short: company.short,
		accent: company.accent,
		from,
		to,
		months: to - from,
		positions: own.map((position) => ({
			position,
			projects: PROJECTS.filter(
				(project) => project.positionId === position.id,
			),
		})),
	};
}).sort((a, b) => b.to - a.to);
---

<div id="role-trajectory" class="trajectory">
  {
    groups.map((group, i) => (
      <section id={`role-trajectory-section-${i}`} class:list={["company", `accent-${group.accent}`]}>
        <header id={`role-trajectory-company-head-${i}`} class="company-head">
          <div id={`role-trajectory-company-head-id-${i}`} class="company-id">
            <span id={`role-trajectory-company-id-dot-${i}`} class="company-dot" aria-hidden="true" />
            <h3 id={`role-trajectory-company-id-name-${i}`} class="company-name">
              <PreviewTerm slug={group.id} idSuffix="roles"
                >{group.company}</PreviewTerm
              >
            </h3>
            <span id={`role-trajectory-company-head-short-${i}`} class="company-short">{group.short}</span>
          </div>
          <p id={`role-trajectory-company-meta-${i}`} class="company-meta">
            {group.positions.length}
            {group.positions.length === 1 ? " puesto" : " puestos"} ·{" "}
            {spanLabel(group.from, group.to)} · {durationLabel(group.months)}
          </p>
        </header>

        <ol id={`role-trajectory-positions-${i}`} class="positions">
          {group.positions.map(({ position, projects }, i2) => (
            <li id={`role-trajectory-positions-li-${i}-${i}-${i}-${i2}`} class:list={["position", `accent-${position.accent}`]}>
              <div id={`role-trajectory-positions-position-top-${i}-${i}-${i}-${i2}`} class="position-top">
                <h4 id={`role-trajectory-position-top-title-${i}-${i}-${i}-${i2}`} class="position-title">{position.title}</h4>
                <span id={`role-trajectory-position-top-dates-${i}-${i}-${i}-${i2}`} class="position-dates">
                  {spanLabel(position.startMonth, position.endMonth)}
                  <span id={`role-trajectory-position-dates-duration-${i}-${i}-${i}-${i2}`} class="position-duration">
                    {durationLabel(position.months)}
                  </span>
                </span>
              </div>

              {(position.place || position.mode) && (
                <p id={`role-trajectory-positions-position-place-${i}-${i}-${i}-${i2}`} class="position-place">
                  {[position.place, position.mode].filter(Boolean).join(" · ")}
                </p>
              )}

              <p id={`role-trajectory-positions-position-focus-${i}-${i}-${i}-${i2}`} class="position-focus">
                <span id={`role-trajectory-position-focus-text-${i}-${i2}`}>
                  <AutoPreviews inline id={`role-trajectory-focus-${i}-${i2}-prose`} text={position.focus} />
                </span>
              </p>
              <p id={`role-trajectory-positions-position-summary-${i}-${i}-${i}-${i2}`} class="position-summary">
                <AutoPreviews inline id={`role-trajectory-summary-${i}-${i2}-prose`} text={position.summary} />
              </p>

              {position.achievements.length > 0 && (
                <ul id={`role-trajectory-positions-position-hitos-${i}-${i}-${i}-${i2}`} class="position-hitos">
                  {position.achievements.map((achievement, i3) => (
                    <li id={`role-trajectory-position-hitos-li-${i}-${i2}-${i}-${i2}-${i}-${i2}-${i3}`}>
                      <AutoPreviews inline id={`role-trajectory-hito-${i}-${i2}-${i3}-prose`} text={achievement} />
                    </li>
                  ))}
                </ul>
              )}

              <div id={`role-trajectory-positions-position-foot-${i}-${i}-${i}-${i2}`} class="position-foot">
                <div id={`role-trajectory-position-foot-group-${i}-${i}-${i}-${i2}`} class="position-group">
                  <span id={`role-trajectory-position-group-eyebrow-${i}-${i}-${i}-${i2}`} class="eyebrow">proyectos</span>
                  <div id={`role-trajectory-position-group-chips-${i}-${i}-${i}-${i2}`} class="position-chips">
                    {projects.map((project, i4) => (
                      <button id={`role-trajectory-position-chips-chip-project-${i}-${i2}-${i}-${i2}-${i}-${i2}-${i4}`}
                        type="button"
                        class="chip-project"
                        data-project={project.id}
                        title={`abrir la ficha de ${project.name}`}
                      >
                        {project.name}
                      </button>
                    ))}
                  </div>
                </div>

                {position.stack.length > 0 && (
                  <div id={`role-trajectory-position-foot-group-2-${i}-${i}-${i}-${i2}`} class="position-group">
                    <span id={`role-trajectory-position-group-eyebrow-2-${i}-${i}-${i}-${i2}`} class="eyebrow">stack</span>
                    <div id={`role-trajectory-position-group-chips-2-${i}-${i}-${i}-${i2}`} class="position-chips">
                      {position.stack.map((item, i5) => {
                        const slug = PREVIEW_BY_STACK_LABEL[item];
                        return slug ? (
                          <PreviewTerm slug={slug} idSuffix={`stack-${i}-${i2}-${i5}`} class="pill">
                            {item}
                          </PreviewTerm>
                        ) : (
                          <span id={`role-trajectory-position-chips-pill-${i}-${i2}-${i}-${i2}-${i}-${i2}-${i5}`} class="pill">{item}</span>
                        );
                      })}
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<script>
  import { openDrawer } from "../lib/open-drawer";

  // The row docks under the section title, whatever height the title takes at
  // this width, so it is measured instead of guessed.
  function placeHeads() {
    const headerHeight = document.querySelector(".site-header")?.getBoundingClientRect().height ?? 0;
    for (const head of document.querySelectorAll<HTMLElement>(".company-head")) {
      const title = head.closest(".section")?.querySelector(".section-head");
      const titleHeight = title?.getBoundingClientRect().height ?? 0;
      // The row's own padding sits above its text, so the box starts that much
      // higher and the text lands where it did: flush against the title, whose
      // painted box ends at the title's height.
      const padding = Number.parseFloat(getComputedStyle(head).paddingTop) || 0;
      // Kept on the element: the hand-over below reads it on every scroll frame.
      head.dataset.base = String(Math.round(headerHeight - 1 + titleHeight + 6 - padding));
      head.style.top = `${head.dataset.base}px`;
    }
    queueDock();
  }

  // Docking: a row holds the slot under the title, and the row that takes the
  // slot pushes it out. Its offset follows the next row's top, so the two hand
  // over flush and stay flush while the one above leaves — the cards never show
  // through a band between them.
  let dockFrame = 0;
  function dockHeads() {
    dockFrame = 0;
    const heads = [...document.querySelectorAll<HTMLElement>(".company-head")];
    // Bottom-up: a row only knows where to sit once the one below is placed.
    for (let index = heads.length - 1; index >= 0; index -= 1) {
      const head = heads[index];
      const base = Number(head.dataset.base) || 0;
      const next = heads[index + 1];
      // Never above the row below: that is the row pushing this one out.
      const pushed = next
        ? Math.min(base, next.getBoundingClientRect().top - head.offsetHeight)
        : base;
      head.style.top = `${pushed}px`;
      const stuck = head.getBoundingClientRect().top <= base + 1;
      head.classList.toggle("is-stuck", stuck);
    }
  }

  function queueDock() {
    if (dockFrame) return;
    dockFrame = requestAnimationFrame(dockHeads);
  }

  window.addEventListener("scroll", queueDock, { passive: true });
  window.addEventListener("resize", placeHeads);
  document.addEventListener("astro:page-load", placeHeads);
  placeHeads();
  // The title can wrap taller once the webfonts land, which would leave the
  // docked row a few pixels inside it; measure again when they do.
  document.fonts?.ready.then(placeHeads);

  // Delegated so it keeps working after a ClientRouter swap replaces the list.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>(".chip-project");
    if (!button) return;
    const id = button.dataset.project;
    if (id) openDrawer({ kind: "project", id, origin: button });
  });
</script>

<style is:global>
  .trajectory {
    display: grid;
    /* No gap and no air between companies: the slot only hands over flush when
       one section ends exactly where the next row's box begins. Anything here
       —a grid gap, a margin, the next section's padding— lengthens the stretch
       the row above can travel while it hands over, and the cards slide
       through the band that opens between the two rows. */
    gap: 0;
  }

  /* The company row docks under the section title while its stints scroll, and
     the arriving row takes the slot by pushing it out, flush. */
  .company-head {
    position: sticky;
    top: calc(var(--header-h, 6.375rem) + 2.6rem);
    z-index: 8;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    /* The air above the row and below its rule lives inside the box, so the
       row that arrives can butt against it: a margin or a border would hold
       the box's edge away and reopen the band. */
    padding-block: 1.25rem 1.5rem;
    background: var(--color-paper);
    transition: box-shadow 260ms ease;
  }

  /* The rule the row sits on, painted instead of a border, so the air under it
     stays inside the box. */
  .company-head::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0.9rem;
    height: 1px;
    background: var(--color-border-subtle);
  }

  /* Docked: it carries a shadow, so the slot reads as taken. It never lifts:
     a transform would open the same band the box is sized to close. */
  .company-head.is-stuck {
    box-shadow: 0 10px 18px -16px color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .company-head {
      transition: none;
    }
  }

  .company-id {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .company-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
    transform: translateY(-0.1rem);
  }

  .company-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .company-short {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .company-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-faint);
  }

  .positions {
    display: grid;
    gap: 0.75rem;
  }

  .position {
    position: relative;
    padding: 1.15rem 1.25rem 1.25rem 1.55rem;
    border: 1px solid var(--color-border);
    border-inline-start: none;
    border-radius: 0 5px 5px 0;
    background: color-mix(in srgb, var(--color-card) 70%, transparent);
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .position::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 5px;
    background: linear-gradient(
      to bottom,
      var(--accent) 0%,
      color-mix(in srgb, var(--accent) 35%, transparent) 100%
    );
  }

  .position:hover {
    background: var(--color-card);
    border-color: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .position-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }

  .position-title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .position-dates {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-muted);
  }

  .position-duration {
    color: var(--color-ink-faint);
  }

  .position-place {
    margin-top: 0.1rem;
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
  }

  .position-focus {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .position-focus::before {
    content: "";
    flex: none;
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: 999px;
    background: var(--accent);
  }

  .position-summary {
    max-inline-size: 46rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .position-hitos {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.7rem;
    font-size: 0.78125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .position-hitos li {
    position: relative;
    padding-inline-start: 0.85rem;
  }

  .position-hitos li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    inline-size: 0.3rem;
    block-size: 1px;
    background: var(--color-ink-faint);
  }

  .position-foot {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .position-foot {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .position-group {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .position-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .chip-project {
    padding: 0.08rem 0.42rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: transparent;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.656rem;
    line-height: 1.5;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background 140ms ease;
  }

  .chip-project:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-tint);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .position {
      padding: 1rem 1rem 1rem 1.3rem;
    }
  }
</style>
