---
import {
	COMPANIES,
	PILLAR_LABEL,
	POSITION_VIEWS,
	PROJECTS,
	type PositionView,
} from "../data/cv";
import { durationLabel, spanLabel } from "../lib/period";

interface Group {
	company: string;
	short: string;
	accent: string;
	from: number;
	to: number;
	months: number;
	positions: {
		position: PositionView;
		projects: typeof PROJECTS;
	}[];
}

const groups: Group[] = COMPANIES.map((company) => {
	const own = POSITION_VIEWS.filter(
		(position) => position.companyId === company.id,
	).sort((a, b) => b.startMonth - a.startMonth);
	const from = Math.min(...own.map((position) => position.startMonth));
	const to = Math.max(...own.map((position) => position.endMonth));
	return {
		company: company.name,
		short: company.short,
		accent: company.accent,
		from,
		to,
		months: to - from,
		positions: own.map((position) => ({
			position,
			projects: PROJECTS.filter(
				(project) => project.positionId === position.id,
			),
		})),
	};
}).sort((a, b) => b.to - a.to);
---

<div class="trajectory">
  {
    groups.map((group) => (
      <section class:list={["company", `accent-${group.accent}`]}>
        <header class="company-head">
          <div class="company-id">
            <span class="company-dot" aria-hidden="true" />
            <h3 class="company-name">{group.company}</h3>
            <span class="company-short">{group.short}</span>
          </div>
          <p class="company-meta">
            {group.positions.length}
            {group.positions.length === 1 ? " puesto" : " puestos"} ·{" "}
            {spanLabel(group.from, group.to)} · {durationLabel(group.months)}
          </p>
        </header>

        <ol class="positions">
          {group.positions.map(({ position, projects }) => (
            <li class:list={["position", `accent-${position.accent}`]}>
              <div class="position-top">
                <h4 class="position-title">{position.title}</h4>
                <span class="position-dates">
                  {spanLabel(position.startMonth, position.endMonth)}
                  <span class="position-duration">
                    {durationLabel(position.months)}
                  </span>
                </span>
              </div>

              {(position.place || position.mode) && (
                <p class="position-place">
                  {[position.place, position.mode].filter(Boolean).join(" · ")}
                </p>
              )}

              <p class="position-focus">{position.focus}</p>
              <p class="position-summary">{position.summary}</p>

              {position.achievements.length > 0 && (
                <ul class="position-hitos">
                  {position.achievements.map((achievement) => (
                    <li>{achievement}</li>
                  ))}
                </ul>
              )}

              <div class="position-foot">
                <div class="position-group">
                  <span class="eyebrow">proyectos</span>
                  <div class="position-chips">
                    {projects.map((project) => (
                      <button
                        type="button"
                        class="chip-project"
                        data-project={project.id}
                        title={`abrir la ficha de ${project.name}`}
                      >
                        {project.name}
                      </button>
                    ))}
                  </div>
                </div>

                {position.stack.length > 0 && (
                  <div class="position-group">
                    <span class="eyebrow">stack</span>
                    <div class="position-chips">
                      {position.stack.map((item) => (
                        <span class="pill">{item}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<script>
  import { openDrawer } from "../lib/open-drawer";

  // Delegated so it keeps working after a ClientRouter swap replaces the list.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>(".chip-project");
    if (!button) return;
    const id = button.dataset.project;
    if (id) openDrawer({ kind: "project", id });
  });
</script>

<style is:global>
  .trajectory {
    display: grid;
    gap: 2.25rem;
  }

  .company-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .company-id {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .company-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
    transform: translateY(-0.1rem);
  }

  .company-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .company-short {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .company-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-faint);
  }

  .positions {
    display: grid;
    gap: 0.75rem;
  }

  .position {
    position: relative;
    padding: 1.15rem 1.25rem 1.25rem 1.55rem;
    border: 1px solid var(--color-border);
    border-inline-start: none;
    border-radius: 0 5px 5px 0;
    background: color-mix(in srgb, var(--color-card) 70%, transparent);
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .position::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 5px;
    background: linear-gradient(
      to bottom,
      var(--accent) 0%,
      color-mix(in srgb, var(--accent) 35%, transparent) 100%
    );
  }

  .position:hover {
    background: var(--color-card);
    border-color: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .position-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }

  .position-title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .position-dates {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-muted);
  }

  .position-duration {
    color: var(--color-ink-faint);
  }

  .position-place {
    margin-top: 0.1rem;
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
  }

  .position-focus {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .position-focus::before {
    content: "";
    flex: none;
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: 999px;
    background: var(--accent);
  }

  .position-summary {
    max-inline-size: 46rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .position-hitos {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.7rem;
    font-size: 0.78125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .position-hitos li {
    position: relative;
    padding-inline-start: 0.85rem;
  }

  .position-hitos li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    inline-size: 0.3rem;
    block-size: 1px;
    background: var(--color-ink-faint);
  }

  .position-foot {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .position-foot {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .position-group {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .position-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .chip-project {
    padding: 0.08rem 0.42rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: transparent;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.656rem;
    line-height: 1.5;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background 140ms ease;
  }

  .chip-project:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-tint);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .position {
      padding: 1rem 1rem 1rem 1.3rem;
    }
  }
</style>
