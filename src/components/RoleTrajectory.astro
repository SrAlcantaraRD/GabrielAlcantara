---
import { PILLAR_LABEL, PROJECTS, ROLES } from "../data/cv";

const stages = [...ROLES]
	.sort((a, b) => b.startYear - a.startYear)
	.map((role) => {
		const projects = PROJECTS.filter((project) => project.roleId === role.id);
		const pillars = [...new Set(projects.flatMap((project) => project.pillars))];
		return { role, projects, pillars };
	});
---

<ol class="stages">
  {
    stages.map(({ role, projects, pillars }) => (
      <li class:list={["stage", `accent-${role.accent}`]}>
        <article class="stage-card">
          <div class="stage-top">
            <div class="stage-id">
              <h3 class="stage-company">{role.company}</h3>
              <span class="stage-role">{role.title}</span>
            </div>
            <span class="stage-period">
              {role.startYear} — {role.endYear}
            </span>
          </div>

          <p class="stage-focus">{role.focus}</p>
          <p class="stage-summary">{role.summary}</p>

          <ul class="stage-hitos">
            {role.achievements.map((achievement) => (
              <li>{achievement}</li>
            ))}
          </ul>

          <div class="stage-foot">
            <div class="stage-group">
              <span class="eyebrow">proyectos</span>
              <div class="stage-chips">
                {projects.map((project) => (
                  <button
                    type="button"
                    class="chip-project"
                    data-project={project.id}
                    title={`abrir la ficha de ${project.project}`}
                  >
                    {project.project}
                  </button>
                ))}
              </div>
            </div>
            <div class="stage-group">
              <span class="eyebrow">
                {role.stack.length > 0 ? "tecnologías clave" : "pilares"}
              </span>
              <div class="stage-chips">
                {role.stack.length > 0
                  ? role.stack.map((item) => <span class="pill">{item}</span>)
                  : pillars.map((pillar) => (
                      <span class="pill">{PILLAR_LABEL[pillar]}</span>
                    ))}
              </div>
            </div>
          </div>
        </article>
      </li>
    ))
  }
</ol>

<script>
  import { openDrawer } from "../lib/open-drawer";

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".chip-project",
  )) {
    button.addEventListener("click", () => {
      const id = button.dataset.project;
      if (id) openDrawer({ kind: "project", id });
    });
  }
</script>

<style is:global>
  .stages {
    display: grid;
    gap: 1rem;
  }

  .stage-card {
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-card) 70%, transparent);
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .stage-card:hover {
    border-color: color-mix(in srgb, var(--color-ink) 20%, transparent);
    background: var(--color-card);
  }

  .stage-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .stage-id {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .stage-company {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .stage-role {
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: var(--accent-tint);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.656rem;
    letter-spacing: 0.04em;
  }

  .stage-period {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
  }

  .stage-focus {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .stage-focus::before {
    content: "";
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 999px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .stage-summary {
    max-inline-size: 48rem;
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .stage-hitos {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .stage-hitos li {
    position: relative;
    padding-inline-start: 0.9rem;
  }

  .stage-hitos li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    inline-size: 0.35rem;
    block-size: 1px;
    background: var(--color-ink-faint);
  }

  .stage-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .stage-foot {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .stage-group {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .stage-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip-project {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: transparent;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background 140ms ease;
  }

  .chip-project:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-tint);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .stage-card {
      padding: 1.25rem;
    }
  }
</style>
