---
/**
 * The single place where page metadata and structured data are produced.
 *
 * Every page passes a unique title and description; the component derives the
 * canonical URL, the Open Graph and Twitter tags, and a JSON-LD graph with the
 * site-wide Person and WebSite plus the page-specific nodes.
 */
import { SITE, type Breadcrumb } from "../data/site";
import {
	LOCALE_META,
	alternateProfilePaths,
	type Locale,
} from "../i18n/routing";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: "website" | "profile" | "article";
	noindex?: boolean;
	breadcrumbs?: Breadcrumb[];
	jsonLd?: Record<string, unknown>[];
	publishedTime?: string;
	modifiedTime?: string;
	articleSection?: string;
	tags?: string[];
	lang?: Locale;
	alternates?: Record<string, string>;
}

const {
	title,
	description,
	image = "/og-image.png",
	imageAlt = "Gabriel Alcántara — Solutions Architect & Software Engineer",
	type = "website",
	noindex = false,
	breadcrumbs,
	jsonLd = [],
	publishedTime,
	modifiedTime,
	articleSection,
	tags,
	lang = getLangFromUrl(Astro.url),
	alternates,
} = Astro.props;
const t = useTranslations(lang);
const meta = LOCALE_META[lang];

// Static pages are emitted as directories; keep the canonical on that form.
const pathname = Astro.url.pathname;
const canonicalPath =
	pathname.endsWith("/") || /\.[a-z0-9]+$/i.test(pathname)
		? pathname
		: `${pathname}/`;
const canonical = new URL(canonicalPath, SITE.url);
const socialImage = new URL(image, SITE.url);
const resolvedAlternates =
	alternates ?? (pathname === "/" ? alternateProfilePaths() : undefined);

const personId = new URL("/#person", SITE.url).href;
const websiteId = new URL("/#website", SITE.url).href;

const person = {
	"@type": "Person",
	"@id": personId,
	name: SITE.name,
	url: SITE.url,
	jobTitle: [...SITE.roles],
	description: SITE.description,
	email: `mailto:${SITE.email}`,
	knowsAbout: SITE.knowsAbout.map((item) => item.en),
	knowsLanguage: ["es", "en", "ca"],
	sameAs: SITE.socials.map((social) => social.href),
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "Universitat Oberta de Catalunya",
	},
};

const website = {
	"@type": "WebSite",
	"@id": websiteId,
	name: SITE.name,
	url: SITE.url,
	description: SITE.description,
	inLanguage: "es-ES",
	author: { "@id": personId },
};

const graph: Record<string, unknown>[] = [person, website];

if (breadcrumbs && breadcrumbs.length > 0) {
	graph.push({
		"@type": "BreadcrumbList",
		itemListElement: [
			{ name: t("nav.home"), url: new URL(lang === "es" ? "/" : `/${lang}/`, SITE.url).href },
			...breadcrumbs.map((item) => ({
				name: item.label,
				...(item.href ? { url: new URL(item.href, SITE.url).href } : {}),
			})),
		].map((item, index) => ({
			"@type": "ListItem",
			position: index + 1,
			...item,
		})),
	});
}

graph.push(...jsonLd);

const structuredData = {
	"@context": "https://schema.org",
	"@graph": graph,
};
---

<title id="seo-title">{title}</title>
<meta id="seo-meta" name="description" content={description} />
<meta id="seo-meta-2" name="author" content={SITE.name} />
<meta id="seo-meta-3" name="google-site-verification" content="p6O44WOiTJBVMZOkSG7fPmxzhaGeCOlqlwjMkMUPbnA" />
<link id="seo-link" rel="canonical" href={canonical.href} />
{
	resolvedAlternates &&
		Object.entries(resolvedAlternates).map(([hrefLang, path], i2) => (
			<link id={`seo-link-2-${i2}`}
				rel="alternate"
				hreflang={hrefLang}
				href={new URL(path, SITE.url).href}
			/>
		))
}
<meta id="seo-meta-4"
	name="robots"
	content={noindex ? "noindex, nofollow" : "max-image-preview:large"}
/>

<!-- Open Graph -->
<meta id="seo-meta-5" property="og:type" content={type} />
<meta id="seo-meta-6" property="og:site_name" content={SITE.name} />
<meta id="seo-meta-7" property="og:locale" content={meta.ogLocale} />
{
	resolvedAlternates &&
		Object.keys(resolvedAlternates)
			.filter((key) => key !== "x-default" && key !== lang)
			.map((key, i3) => (
				<meta id={`seo-meta-8-item-${i3}`}
					property="og:locale:alternate"
					content={LOCALE_META[key as Locale].ogLocale}
				/>
			))
}
<meta id="seo-meta-8" property="og:url" content={canonical.href} />
<meta id="seo-meta-9" property="og:title" content={title} />
<meta id="seo-meta-10" property="og:description" content={description} />
<meta id="seo-meta-11" property="og:image" content={socialImage.href} />
<meta id="seo-meta-12" property="og:image:type" content="image/png" />
<meta id="seo-meta-13" property="og:image:width" content="1200" />
<meta id="seo-meta-14" property="og:image:height" content="630" />
<meta id="seo-meta-15" property="og:image:alt" content={imageAlt} />
{publishedTime && <meta id="seo-meta-16" property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta id="seo-meta-17" property="article:modified_time" content={modifiedTime} />}
{articleSection && <meta id="seo-meta-18" property="article:section" content={articleSection} />}
{tags?.map((tag, i4) => <meta id={`seo-meta-19-item-${i4}`} property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta id="seo-meta-19" name="twitter:card" content="summary_large_image" />
<meta id="seo-meta-20" name="twitter:site" content="@SrAlcantaraRD" />
<meta id="seo-meta-21" name="twitter:creator" content="@SrAlcantaraRD" />
<meta id="seo-meta-22" name="twitter:title" content={title} />
<meta id="seo-meta-23" name="twitter:description" content={description} />
<meta id="seo-meta-24" name="twitter:image" content={socialImage.href} />
<meta id="seo-meta-25" name="twitter:image:alt" content={imageAlt} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
