---
import { POSITION_VIEWS } from "../data/cv";
import { SITE } from "../data/site";
import type { Locale } from "../i18n/routing";
import { navItems } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import AskAiLinks from "./AskAiLinks.astro";

interface Props {
	lang?: Locale;
}

const { lang } = Astro.props;
const locale = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const items = navItems(locale);
const localized = locale !== "es";

const year = new Date().getFullYear();
const companies = [...new Set(POSITION_VIEWS.map((position) => position.company))];

const cvHref = localized ? "#cv" : "/cv/";
const careerHref = localized ? "#experiencia" : "/experience/";
const nakireHref = localized ? "#proyectos" : "/projects/nakire-tps/";
const bodegaHref = localized ? "#proyectos" : "/projects/bodega-digital/";
const pachangaHref = localized ? "#proyectos" : "/projects/pachanga-community/";
---

<footer id="site-footer"
	class="site-footer"
	transition:persist={`site-footer-${locale}`}
	data-locale={locale}
>
	<div id="site-footer-container" class="container footer-grid">
		<div id="site-footer-container-brand" class="footer-brand">
			<span id="site-footer-brand-name" class="footer-name">{SITE.name}</span>
			<p id="site-footer-brand-role" class="footer-role">{t("footer.role")}</p>
			<p id="site-footer-brand-availability" class="footer-availability">
				<span id="site-footer-availability-dot" class="dot" aria-hidden="true"></span>
				{t("footer.availability")} · {t("footer.location")}
			</p>
		</div>

		<nav id="site-footer-container-col" class="footer-col" aria-label={t("footer.sections")}>
			<span id="site-footer-col-heading" class="footer-heading">{t("footer.sections")}</span>
			<ul id="site-footer-col-ul">
				{items.map((item, i) => <li id={`site-footer-col-li-item-${i}`}><a id={`site-footer-col-a-item-${i}`} href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>

		<div id="site-footer-container-col-2" class="footer-col">
			<span id="site-footer-col-heading-2" class="footer-heading">{t("footer.profile")}</span>
			<ul id="site-footer-col-ul-2">
				<li id="site-footer-col-li"><a id="site-footer-col-a" href={cvHref}>{t("footer.fullCv")}</a></li>
				<li id="site-footer-col-li-2"><a id="site-footer-col-a-2" href={careerHref}>{t("footer.career")}</a></li>
				<li id="site-footer-col-li-3"><a id="site-footer-col-a-3" href={nakireHref}>Nakire TPS</a></li>
				<li id="site-footer-col-li-4"><a id="site-footer-col-a-4" href={bodegaHref}>Bodega Digital</a></li>
				<li id="site-footer-col-li-5"><a id="site-footer-col-a-5" href={pachangaHref}>Pachanga Community</a></li>
			</ul>
		</div>

		<div id="site-footer-container-col-3" class="footer-col">
			<span id="site-footer-col-heading-3" class="footer-heading">{t("footer.contact")}</span>
			<ul id="site-footer-col-ul-3">
				<li id="site-footer-col-li-6"><a id="site-footer-col-a-6" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
				{
					SITE.socials.map((social, i2) => (
						<li id={`site-footer-col-li-7-${i2}`}>
							<a id={`site-footer-col-a-7-${i2}`} href={social.href} rel="me">
								{social.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div id="site-footer-container-ask" class="container footer-ask">
		<AskAiLinks lang={locale} />
	</div>

	<div id="site-footer-container-2" class="container footer-bottom">
		<span id="site-footer-container-span">© {year} {SITE.name}</span>
		<span id="site-footer-container-meta" class="footer-meta">
			{companies.length} {t("footer.stages")} · {t("footer.since")} {SITE.careerStart}
		</span>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		background: var(--color-paper);
	}

	.footer-grid {
		display: grid;
		gap: 2rem;
		padding-block: 3rem 2rem;
	}

	@media (min-width: 768px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem 2.5rem;
		}

		.footer-brand {
			grid-column: 1 / -1;
			max-inline-size: 32rem;
		}
	}

	@media (min-width: 1024px) {
		.footer-grid {
			grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
			gap: 2.5rem;
		}

		.footer-brand {
			grid-column: auto;
			max-inline-size: 24rem;
		}
	}

	.footer-brand {
		display: grid;
		gap: 0.7rem;
		align-content: start;
		max-inline-size: 24rem;
	}

	.footer-name {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 400;
		color: var(--color-ink);
	}

	.footer-role {
		font-size: 0.75rem;
		line-height: 1.7;
		color: var(--color-ink-muted);
	}

	.footer-availability {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-sage);
	}

	.dot {
		inline-size: 0.375rem;
		block-size: 0.375rem;
		border-radius: 999px;
		background: var(--color-available);
	}

	.footer-col {
		display: grid;
		gap: 0.7rem;
		align-content: start;
		min-inline-size: 0;
	}

	.footer-heading {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
	}

	.footer-col ul {
		display: grid;
		gap: 0.35rem;
	}

	.footer-col a {
		font-size: 0.75rem;
		color: var(--color-ink-muted);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.footer-col a:hover {
		color: var(--color-ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* From 768px up the ask links live here: a utility about the site, not
	   navigation. Below that they stay in the menu, where the thumb reaches
	   them without crossing ten screens of page. */
	.footer-ask {
		display: none;
		justify-content: flex-end;
		padding-block-end: 1rem;
	}

	@media (min-width: 768px) {
		.footer-ask {
			display: flex;
		}
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-block: 1.25rem;
		border-top: 1px solid var(--color-border-subtle);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-ink-faint);
	}

	.footer-meta {
		letter-spacing: 0.04em;
	}
</style>
