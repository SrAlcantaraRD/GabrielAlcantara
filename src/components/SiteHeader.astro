---
import type { Breadcrumb } from "../data/site";
import { SITE } from "../data/site";
import { localeRoot, type Locale } from "../i18n/routing";
import { navItems } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Breadcrumbs from "./Breadcrumbs.astro";
import AskAiLinks from "./AskAiLinks.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	breadcrumbs?: Breadcrumb[];
	lang?: Locale;
}

const { breadcrumbs, lang } = Astro.props;
const locale = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const items = navItems(locale).filter((item) => item.key !== "home");
const showBreadcrumbs = breadcrumbs && breadcrumbs.length > 0;
const pathname = Astro.url.pathname;
const home = localeRoot(locale);
const localized = locale !== "es";

const active = (item: (typeof items)[number]) => {
	if (!localized) {
		if (item.href === "/") return pathname === "/";
		return pathname === item.href || pathname.startsWith(item.href);
	}
	return item.key === "home" && pathname === home;
};

const cvHref = localized ? "#cv" : "/cv/";
const contactHref = localized ? "#contacto" : "/contact/";
---

<header
  class="site-header"
  transition:persist={`site-header-${locale}`}
  data-locale={locale}
>
  <div class="container header-inner">
    <a class="brand" href={home}>
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-role">Solutions Architect · Software Engineer</span>
    </a>

    <nav class="site-nav" aria-label={t("mainNav")}>
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { "is-active": active(item) }]}
            aria-current={active(item) ? "page" : undefined}
            data-nav-key={item.key}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <LanguageSwitcher lang={locale} />
      <ThemeToggle lang={locale} />
    </div>

    <div class="header-actions">
      <a class="action-cv" href={cvHref}>{t("cv")}</a>
      <a class="action-contact" href={contactHref}>{t("contact")}</a>
    </div>

    <details class="mobile-menu">
      <summary>
        <span>{t("menu")}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="menu-panel">
        <nav aria-label={t("mobileNav")}>
          <ul>
            {
              items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={{ "is-active": active(item) }}
                    aria-current={active(item) ? "page" : undefined}
                    data-nav-key={item.key}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li><a href={cvHref}>{t("cv")}</a></li>
          </ul>
        </nav>
        <div class="menu-ask">
          <AskAiLinks variant="menu" lang={locale} />
        </div>
      </div>
    </details>
  </div>

  <div class="container header-crumbs">
    <Breadcrumbs
      items={breadcrumbs ?? []}
      hidden={!showBreadcrumbs}
      lang={locale}
    />
    <div class="header-ask">
      <AskAiLinks lang={locale} />
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  const crumbs = document.querySelector<HTMLElement>(".header-crumbs .breadcrumbs");
  const linkedCrumbs = crumbs?.querySelector("li")?.cloneNode(true) as HTMLLIElement | undefined;

  function closeMenu() {
    menu?.removeAttribute("open");
  }

  function syncNav() {
    const path = window.location.pathname;
    const hash = window.location.hash;
    const locale = path.startsWith("/en/") ? "en" : path.startsWith("/ca/") ? "ca" : "es";
    const links = document.querySelectorAll<HTMLAnchorElement>(
      ".site-nav .nav-link, .mobile-menu a[data-nav-key]",
    );

    if (locale !== "es") {
      for (const link of links) {
        const target = new URL(link.href, window.location.origin);
        const isHome = target.hash === "";
        const active = isHome
          ? !hash && target.pathname === path
          : target.hash === hash;
        link.classList.toggle("is-active", active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
      return;
    }

    for (const link of links) {
      const target = new URL(link.href, window.location.origin).pathname;
      const active = target === "/" ? path === "/" : path === target || path.startsWith(target);
      link.classList.toggle("is-active", active);
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }
  }

  function syncCrumbs() {
    if (!crumbs || !linkedCrumbs) return;

    const source = document.getElementById("page-breadcrumbs");
    let items: { label: string; href?: string }[] = [];
    try {
      items = JSON.parse(source?.getAttribute("data-items") ?? "[]");
    } catch {
      items = [];
    }

    const list = crumbs.querySelector("ol");
    const home = linkedCrumbs.cloneNode(true) as HTMLLIElement;
    const fragment = document.createDocumentFragment();
    fragment.append(home);

    for (const item of items) {
      const entry = linkedCrumbs.cloneNode(true) as HTMLLIElement;
      const link = entry.querySelector("a");
      if (!link) continue;

      if (item.href) {
        link.href = item.href;
        link.textContent = item.label;
      } else {
        const current = document.createElement("span");
        current.setAttribute("aria-current", "page");
        for (const attribute of Array.from(link.attributes)) {
          if (attribute.name.startsWith("data-astro-cid-")) {
            current.setAttribute(attribute.name, attribute.value);
          }
        }
        current.textContent = item.label;
        link.replaceWith(current);
      }
      fragment.append(entry);
    }

    list?.replaceChildren(fragment);
    crumbs.hidden = items.length === 0;
  }

  function markClicked(event: Event) {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>(
      ".site-nav .nav-link, .mobile-menu a[data-nav-key]",
    );
    if (!link) return;

    const targetUrl = new URL(link.href, window.location.origin);
    if (!targetUrl.hash) return;

    for (const candidate of document.querySelectorAll<HTMLAnchorElement>(
      ".site-nav .nav-link, .mobile-menu a[data-nav-key]",
    )) {
      const candidateHash = new URL(candidate.href, window.location.origin).hash;
      const active = candidateHash === targetUrl.hash;
      candidate.classList.toggle("is-active", active);
      if (active) candidate.setAttribute("aria-current", "page");
      else candidate.removeAttribute("aria-current");
    }
  }

  function sync() {
    closeMenu();
    syncNav();
    syncCrumbs();
    // ClientRouter applies the new hash after the page-load event; run once
    // more on the next frame so the active section is never one step behind.
    requestAnimationFrame(syncNav);
  }

  sync();
  document.addEventListener("astro:page-load", sync);
  document.addEventListener("astro:before-swap", closeMenu);
  document.addEventListener("click", markClicked, true);
  window.addEventListener("hashchange", syncNav);
  window.addEventListener("popstate", syncNav);
</script>

<style>
  .site-header {
    /* Single spacing token: the gap above the brand and the gap below the
       breadcrumbs both resolve to it, so the header stays balanced. */
    --header-space: 1rem;
    --crumbs-line: 0.875rem;
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-paper) 94%, transparent);
    backdrop-filter: blur(8px);
  }

  .header-inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.7rem;
    padding-block-start: var(--header-space);
  }

  /* Reserved strip: fixed height keeps the header constant with or without
     breadcrumbs, while centering the text leaves an equal gap above and below. */
  .header-crumbs {
    display: flex;
    align-items: center;
    gap: 1rem;
    block-size: calc(var(--header-space) * 2 + var(--crumbs-line));
  }

  /* The strip is empty on mobile, but the ask links still need a full menu
     with names, so below 768px they live inside the menu panel instead. */
  .header-ask {
    display: none;
    flex: none;
    margin-inline-start: auto;
  }

  .menu-ask {
    display: block;
  }

  @media (min-width: 768px) {
    .header-ask {
      display: block;
    }

    .menu-ask {
      display: none;
    }
  }

  .brand {
    display: grid;
    flex: 1 1 auto;
    gap: 0.05rem;
    min-inline-size: 0;
    text-decoration: none;
  }

  .brand-name {
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand-role {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink-faint);
  }

  .site-nav {
    display: none;
    flex: none;
  }

  .site-nav .nav-link {
    padding-block: 0.25rem;
    font-size: 0.75rem;
    white-space: nowrap;
    color: var(--color-ink-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .site-nav .nav-link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-border);
  }

  .site-nav .nav-link.is-active {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .header-tools {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.3rem;
  }

  .header-actions {
    display: none;
    flex: none;
    align-items: center;
    gap: 0.4rem;
  }

  .action-cv,
  .action-contact {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    font-size: 0.6875rem;
    white-space: nowrap;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background 140ms ease,
      color 140ms ease;
  }

  .action-cv {
    color: var(--color-ink-muted);
  }

  .action-cv:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .action-contact {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .action-contact:hover {
    background: var(--color-ink-hover);
    border-color: var(--color-ink-hover);
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary svg {
    inline-size: 0.9rem;
    block-size: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .mobile-menu[open] summary {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .menu-panel {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 0.5rem);
    z-index: 40;
    min-inline-size: 12rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-card);
    box-shadow: var(--shadow);
  }

  .mobile-menu ul {
    display: grid;
    gap: 0.1rem;
  }

  .mobile-menu a {
    display: block;
    padding: 0.45rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .mobile-menu a:hover,
  .mobile-menu a.is-active {
    background: var(--color-paper-warm);
    color: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .site-nav {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .header-actions {
      display: flex;
    }

    .mobile-menu {
      display: none;
    }
  }

  @media (min-width: 1024px) and (max-width: 1199px) {
    .action-cv {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .header-inner {
      /* Top-align so the gap above the brand matches the gap below the crumbs. */
      align-items: start;
    }

    .brand {
      margin-inline-end: auto;
    }
  }

  @media (max-width: 639px) {
    .brand-role {
      display: none;
    }

    .header-inner {
      gap: 0.6rem;
    }
  }
</style>
