---
import Layout from "./Layout.astro";
import PostCard from "../components/PostCard.astro";
import { PROJECTS } from "../data/cv";
import { PROJECT_CASES } from "../data/projects";
import { SITE } from "../data/site";
import {
	categoryOf,
	formatDateIn,
	postHrefIn,
	relatedPosts,
	type PostMeta,
} from "../data/blog";
import { EDITORIAL } from "../i18n/editorial";
import { PROFILE } from "../i18n/profile";
import type { Locale } from "../i18n/routing";
import AutoPreviews from "../components/AutoPreviews.astro";

interface Props extends PostMeta {
	lang?: Locale;
	alternates?: Record<string, string>;
}

const { lang = "es", alternates, ...post } = Astro.props as Props;
const category = categoryOf(post.category);
const localized = lang === "es" ? undefined : PROFILE[lang].posts[post.slug];
const editorial = lang === "es" ? undefined : EDITORIAL[lang];
const title = localized?.title ?? post.title;
const description = localized?.description ?? post.description;
const categoryLabel = localized?.category ?? category.label;
const tags = lang === "es" ? post.tags : EDITORIAL[lang].posts[post.slug].tags;
const readingLabel = editorial?.article.readingTime ?? "min de lectura";
const blogHref = lang === "es" ? "/blog/" : `/${lang}/blog/`;
const projectsHref = lang === "es" ? "/projects/" : `/${lang}/projects/`;
const related = relatedPosts(post);
const projects = post.projectIds.flatMap((id) => {
	const project = PROJECTS.find((item) => item.id === id);
	return project ? [project] : [];
});

/** Case-study URL for a project, when one exists; the index otherwise. */
const caseHref = new Map(
	PROJECT_CASES.map((item) => [
		item.id,
		item.caseStudyHref
			? lang === "es"
				? item.caseStudyHref
				: `/${lang}${item.caseStudyHref}`
			: undefined,
	]),
);

const articleUrl = new URL(postHrefIn(lang, post.slug), SITE.url).href;
const personId = new URL("/#person", SITE.url).href;
const inLanguage = lang === "es" ? "es-ES" : lang === "en" ? "en-GB" : "ca-ES";

const jsonLd = [
	{
		"@type": "BlogPosting",
		"@id": `${articleUrl}#article`,
		headline: title,
		description,
		datePublished: post.date,
		dateModified: post.updated ?? post.date,
		inLanguage,
		articleSection: categoryLabel,
		keywords: tags.join(", "),
		url: articleUrl,
		mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
		author: { "@id": personId },
		publisher: { "@id": personId },
		image: new URL("/og-image.png", SITE.url).href,
	},
];
---

<Layout
  title={`${title} | Gabriel Alcántara`}
  description={description}
  image={post.image ?? `/og/${post.slug}.png`}
  imageAlt={`${post.cardTitle ?? title} — Gabriel Alcántara`}
  type="article"
  lang={lang}
  alternates={alternates}
  publishedTime={post.date}
  modifiedTime={post.updated ?? post.date}
  articleSection={categoryLabel}
  tags={tags}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: "Blog", href: blogHref },
    ...(lang === "es"
      ? [{ label: category.label, href: `/blog/categoria/${category.slug}/` }]
      : []),
    { label: title },
  ]}
>
  <article id="article-layout" class="article">
    <header id="article-layout-head" class="article-head">
      <p id="article-layout-head-kicker" class="kicker">
        {lang === "es" ? (
          <a id="article-layout-kicker-a" href={`/blog/categoria/${category.slug}/`}>{categoryLabel}</a>
        ) : (
          <span id="article-layout-kicker-span">{categoryLabel}</span>
        )}
        <span id="article-layout-kicker-span-2" aria-hidden="true">·</span>
        <time id="article-layout-kicker-time" datetime={post.date}>{formatDateIn(post.date, lang)}</time>
        <span id="article-layout-kicker-span-3" aria-hidden="true">·</span>
        <span id="article-layout-kicker-span-4">{post.readingMinutes} {readingLabel}</span>
      </p>
      <h1 id="article-layout-head-display" class="display">{title}</h1>
      <p id="article-layout-head-lede" class="lede">{description}</p>
      <div id="article-layout-head-tag-row" class="tag-row">
        {tags.map((tag, i) => <span id={`article-layout-tag-row-pill-${i}`} class="pill">{tag}</span>)}
      </div>
      {post.updated && (
        <p id="article-layout-head-updated" class="updated">
          {editorial?.article.updated ?? "Actualizado el"}{" "}
          {formatDateIn(post.updated, lang)}
        </p>
      )}
    </header>

    <AutoPreviews id="article-layout-prose" class="prose">
      <slot />
    </AutoPreviews>

    <footer id="article-layout-foot" class="article-foot">
      {
        projects.length > 0 && (
          <section id="article-layout-foot-related-projects" class="related-projects" aria-labelledby="proyectos-relacionados">
            <h2 class="section-title" id="proyectos-relacionados">
              {editorial?.article.relatedProject ?? "Proyecto relacionado"}
            </h2>
            <ul id="article-layout-related-projects-ul">
              {projects.map((project, i2) => (
                <li id={`article-layout-related-projects-li-${i2}`}>
                  <a id={`article-layout-related-projects-a-${i2}`} href={caseHref.get(project.id) ?? projectsHref}>
                    <strong id={`article-layout-related-projects-strong-${i2}`}>{project.name}</strong>
                    <span id={`article-layout-related-projects-span-${i2}`}>
                      {project.company} ·{" "}
                      {lang === "es"
                        ? project.summary
                        : PROFILE[lang].projects[project.id]?.outcome ??
                          project.summary}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section id="article-layout-foot-related-posts" class="related-posts" aria-labelledby="articulos-relacionados">
            <h2 class="section-title" id="articulos-relacionados">
              {editorial?.article.relatedArticles ?? "Artículos relacionados"}
            </h2>
            <div id="article-layout-related-posts-list" class="related-list">
              {related.map((item) => <PostCard post={item} compact lang={lang} />)}
            </div>
          </section>
        )
      }

      <section id="article-layout-foot-cta" class="cta" aria-labelledby="cta-articulo">
        <h2 class="section-title" id="cta-articulo">
          {editorial?.article.nextTitle ?? "Siguiente paso"}
        </h2>
        <p id="article-layout-cta-p">
          {editorial?.article.nextBody ??
            "Si estás trabajando en un problema parecido y quieres contrastarlo, puedes escribirme. También puedes ver el resto de proyectos o descargar el CV."}
        </p>
        <div id="article-layout-cta-actions" class="actions">
          <a id="article-layout-actions-btn" class="btn" href={`mailto:${SITE.email}`}>
            {editorial?.article.writeCta ?? "Escríbeme"}
          </a>
          <a id="article-layout-actions-btn-2" class="btn btn--ghost" href={projectsHref}>
            {editorial?.article.projectsCta ?? "Ver proyectos"}
          </a>
          <a id="article-layout-actions-btn-3" class="btn btn--ghost" href="/cv/">
            {editorial?.article.cvCta ?? "Ver CV"}
          </a>
        </div>
      </section>
    </footer>
  </article>
</Layout>

<style>
  .article {
    display: grid;
    gap: 2.5rem;
  }

  .article-head {
    display: grid;
    gap: 0.85rem;
    max-inline-size: 50rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.656rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .kicker a {
    color: var(--color-terracotta);
    text-decoration: none;
  }

  .kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .updated {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-faint);
  }

  .article-foot {
    display: grid;
    gap: 2.5rem;
    max-inline-size: 46rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .article-foot .section-title {
    display: block;
    margin-bottom: 0.9rem;
  }

  .related-projects ul {
    display: grid;
    gap: 0.75rem;
  }

  .related-projects a {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    background: color-mix(in srgb, var(--color-card) 70%, transparent);
  }

  .related-projects a:hover {
    border-color: color-mix(in srgb, var(--color-ink) 20%, transparent);
  }

  .related-projects strong {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .related-projects span {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .related-list {
    display: grid;
    gap: 0.35rem;
  }

  .cta {
    display: grid;
    gap: 0.8rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-paper-warm);
  }

  .cta p {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    max-inline-size: 38rem;
  }
</style>
