---
import "@fontsource-variable/inter";
import "@fontsource/caveat";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Gabriel Alcántara — Solutions Architect & Full Stack Developer",
	description = "Curioso empedernido. Diseño y construyo sistemas: desde 2011, de full stack developer a solutions architect. Event-driven architecture, TDD, cloud e IA aplicada.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <slot />
  </body>
</html>
