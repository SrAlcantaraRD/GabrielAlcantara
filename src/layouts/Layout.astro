---
import "@fontsource/newsreader/300.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/500.css";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import Seo from "../components/Seo.astro";
import type { Breadcrumb } from "../data/site";
import type { Locale } from "../i18n/routing";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EasterEgg from "../components/EasterEgg.astro";
import LocaleTransition from "../components/LocaleTransition.astro";

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: "website" | "profile" | "article";
	noindex?: boolean;
	breadcrumbs?: Breadcrumb[];
	jsonLd?: Record<string, unknown>[];
	publishedTime?: string;
	modifiedTime?: string;
	articleSection?: string;
	tags?: string[];
	lang?: Locale;
	alternates?: Record<string, string>;
}

const { breadcrumbs, lang, alternates, ...seo } = Astro.props;
const locale = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				try {
					const stored = localStorage.getItem("theme");
					const system = matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light";
					const theme = stored === "light" || stored === "dark" ? stored : system;
					root.dataset.theme = theme;
					root.style.colorScheme = theme;
				} catch {
					root.dataset.theme = "light";
				}
			})();
		</script>

		<ClientRouter />
		<Seo {...seo} breadcrumbs={breadcrumbs} lang={locale} alternates={alternates} />

		<!-- Icons & PWA -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" sizes="32x32" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#faf8f5" />
		<meta name="color-scheme" content="light dark" />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">{t("skip")}</a>
		<SiteHeader breadcrumbs={breadcrumbs} lang={locale} />
		<main id="contenido" class="main container">
			<slot />
		</main>
		<SiteFooter lang={locale} />
		<EasterEgg />
		<LocaleTransition />
		<div
			id="page-breadcrumbs"
			hidden
			aria-hidden="true"
			data-items={JSON.stringify(breadcrumbs ?? [])}
		></div>
		<script>
			import "../lib/title-morph";
			import "../lib/client/site";
			import "../lib/client/locale-transition";
		</script>
	</body>
</html>
