---
import "@fontsource/newsreader/300.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/500.css";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import Seo from "../components/Seo.astro";
import type { Breadcrumb } from "../data/site";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EasterEgg from "../components/EasterEgg.astro";

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: "website" | "profile" | "article";
	noindex?: boolean;
	breadcrumbs?: Breadcrumb[];
	jsonLd?: Record<string, unknown>[];
	publishedTime?: string;
	modifiedTime?: string;
	articleSection?: string;
	tags?: string[];
}

const { breadcrumbs, ...seo } = Astro.props;
const showBreadcrumbs = breadcrumbs && breadcrumbs.length > 0;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<ClientRouter />
		<Seo {...seo} breadcrumbs={breadcrumbs} />

		<!-- Icons & PWA -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" sizes="32x32" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#faf8f5" />
		<meta name="color-scheme" content="light" />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<SiteHeader />
		<main id="contenido" class="main container">
			{showBreadcrumbs && <Breadcrumbs items={breadcrumbs} />}
			<slot />
		</main>
		<SiteFooter />
		<EasterEgg />
	</body>
</html>
