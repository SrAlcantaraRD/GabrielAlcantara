---
import "@fontsource/newsreader/300.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/500.css";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import Seo from "../components/Seo.astro";
import type { Breadcrumb } from "../data/site";
import type { Locale } from "../i18n/routing";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EasterEgg from "../components/EasterEgg.astro";
import LocaleTransition from "../components/LocaleTransition.astro";

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: "website" | "profile" | "article";
	noindex?: boolean;
	breadcrumbs?: Breadcrumb[];
	jsonLd?: Record<string, unknown>[];
	publishedTime?: string;
	modifiedTime?: string;
	articleSection?: string;
	tags?: string[];
	lang?: Locale;
	alternates?: Record<string, string>;
}

const { breadcrumbs, lang, alternates, ...seo } = Astro.props;
const locale = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<!doctype html>
<html id="layout-html" lang={locale}>
	<head id="layout-head">
		<meta id="layout-meta" charset="UTF-8" />
		<meta id="layout-meta-2" name="viewport" content="width=device-width, initial-scale=1" />
		<meta id="layout-meta-theme-light" name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" data-theme-scheme="light" />
		<meta id="layout-meta-theme-dark" name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" data-theme-scheme="dark" />
		<meta id="layout-meta-color-scheme" name="color-scheme" content="light dark" />
		<script is:inline>
			(() => {
				// The <meta> is the state and global.css maps it back with :has(), so
				// this runs inline, after the tag, and the first paint is already in the
				// stored scheme. `light dark` (no stored value) follows the OS on its own.
				let stored = null;
				try {
					stored = localStorage.getItem("theme");
				} catch {
					// Storage can be blocked; the site then simply follows the system.
				}
				const pinned =
					stored === "light" || stored === "dark" ? stored : null;
				const meta = document.querySelector('meta[name="color-scheme"]');
				if (meta) meta.content = pinned ?? "light dark";
				if (!pinned) return;
				// The colour is the pair the head already ships; read it, do not repeat it.
				const source = document.querySelector(
					`meta[name="theme-color"][data-theme-scheme="${pinned}"]`,
				);
				if (!source) return;
				// A theme-color tag without media always matches and, placed first, is
				// the one the browser reads; the pair above covers the system's case.
				const first = document.querySelector('meta[name="theme-color"]');
				const tag = document.createElement("meta");
				tag.name = "theme-color";
				tag.dataset.themeOverride = "";
				tag.content = source.content;
				document.head.insertBefore(tag, first ?? document.head.firstChild);
			})();
		</script>

		<ClientRouter />
		<Seo {...seo} breadcrumbs={breadcrumbs} lang={locale} alternates={alternates} />

		<!-- Icons & PWA -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" sizes="32x32" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">{t("skip")}</a>
		<SiteHeader breadcrumbs={breadcrumbs} lang={locale} />
		<main id="contenido" class="main container">
			<slot />
		</main>
		<SiteFooter lang={locale} />
		<EasterEgg />
		<LocaleTransition />
		<div
			id="page-breadcrumbs"
			hidden
			aria-hidden="true"
			data-items={JSON.stringify(breadcrumbs ?? [])}
		></div>
		<script>
			import "../lib/title-morph";
			import "../lib/client/site";
			import "../lib/client/locale-transition";
		</script>
	</body>
</html>
