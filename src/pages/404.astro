---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada | Gabriel Alcántara"
  description="La página que buscas no existe o se ha movido."
  noindex
>
  <header id="404-page-head" class="page-head not-found">
    <p id="404-page-head-eyebrow" class="eyebrow">404</p>
    <h1 id="404-page-head-display" class="display">Esta página no existe.</h1>
    <p id="404-page-head-lede" class="lede">
      Puede que el enlace esté mal escrito o que la página se haya movido. Desde aquí
      puedes volver al inicio o ir directamente a lo que probablemente buscabas.
    </p>
    <div id="404-page-head-actions" class="actions">
      <a id="404-actions-btn" class="btn" href="/">Volver al inicio</a>
      <a id="404-actions-btn-2" class="btn btn--ghost" href="/cv/">Ver el CV</a>
      <a id="404-actions-btn-3" class="btn btn--ghost" href="/projects/">Ver proyectos</a>
      <a id="404-actions-btn-4" class="btn btn--link" href="/contact/">Contactar</a>
    </div>
  </header>
</Layout>

<style>
  .not-found {
    padding-block: 3rem;
  }
</style>
