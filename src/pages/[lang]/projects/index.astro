---
/**
 * Translated projects index, generated once per locale from the route table.
 */
import LocalizedProjectsIndex from "../../../components/LocalizedProjectsIndex.astro";
import { translatedLocales } from "../../../lib/routes";
import type { TranslatedLocale } from "../../../i18n/routing";

export function getStaticPaths() {
	return translatedLocales("projects").map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: TranslatedLocale };
---

<LocalizedProjectsIndex {lang} />
