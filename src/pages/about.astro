---
import Layout from "../layouts/Layout.astro";
import { SITE, PRINCIPLES, SPECIALTIES } from "../data/site";
import { COMPANIES, POSITION_VIEWS, PROJECTS } from "../data/cv";
import { spanLabel } from "../lib/period";
import AutoPreviews from "../components/AutoPreviews.astro";

const companies = COMPANIES.map((company) => {
	const own = POSITION_VIEWS.filter(
		(position) => position.companyId === company.id,
	).sort((a, b) => a.startMonth - b.startMonth);
	return {
		...company,
		from: Math.min(...own.map((position) => position.startMonth)),
		to: Math.max(...own.map((position) => position.endMonth)),
		first: own[0],
		last: own[own.length - 1],
	};
}).sort((a, b) => a.from - b.from);

const jsonLd = [
	{
		"@type": "ProfilePage",
		"@id": new URL("/about/", SITE.url).href + "#webpage",
		url: new URL("/about/", SITE.url).href,
		name: "Sobre Gabriel Alcántara | Arquitectura de software",
		description:
			"Perfil profesional de Gabriel Alcántara: arquitectura de software, sistemas distribuidos, automatización industrial y liderazgo técnico.",
		inLanguage: "es-ES",
		about: { "@id": new URL("/#person", SITE.url).href },
		mainEntity: { "@id": new URL("/#person", SITE.url).href },
	},
];
---

<Layout
  title="Sobre Gabriel Alcántara | Arquitectura de software"
  description="Arquitecto de software y Software Engineer con más de quince años diseñando, construyendo y evolucionando sistemas. Cómo trabajo, qué principios sigo y qué retos me interesan."
  type="profile"
  jsonLd={jsonLd}
  breadcrumbs={[{ label: "Sobre mí" }]}
>
  <header id="about-page-head" class="page-head">
    <p id="about-page-head-eyebrow" class="eyebrow">Sobre mí</p>
    <h1 id="about-page-head-display" class="display">Arquitectura, ingeniería, mentoría y consultoría.</h1>
    <p id="about-page-head-lede" class="lede">
      Soy arquitecto de software y Software Engineer con más de quince años de experiencia
      diseñando, construyendo y evolucionando sistemas de software. Mi trabajo combina
      arquitectura, desarrollo backend, sistemas distribuidos, automatización y
      liderazgo técnico.
    </p>
  </header>

  <section id="about-section" class="section" aria-labelledby="trayectoria-title">
    <div id="about-section-head" class="section-head">
      <h2 class="section-title" id="trayectoria-title">Trayectoria profesional</h2>
      <span id="about-section-head-meta" class="section-meta">desde {SITE.careerStart}</span>
    </div>
    <AutoPreviews id="about-section-prose" class="prose">
      <p id="about-prose-p">
        Empecé en 2011 en <strong id="about-prose-strong">ACD Sistemes</strong>, una empresa de producto, donde
        trabajé en el producto de auditoría contable: consultas SQL, el importador de
        datos y la migración del auditor de Delphi a Velneo. Con 21 años viajé a Brasil y
        Angola para implantar y desplegar soluciones de auditoría en instituciones
        públicas. Después llegaron las soluciones web del producto concursal y la
        responsabilidad técnica sobre ellas.
      </p>
      <p id="about-prose-p-2">
        En <strong id="about-prose-strong-2">Basetis</strong> entré como full stack y acabé como team lead. Pasé
        por desarrollo web y móvil para la Generalitat, Siebel para ACA CSV, un producto
        con capa de integración Mulesoft y gestión de equipo, mantenimiento de
        aplicaciones sobre EC2 y LoveISDIN, donde definí PRDs con negocio, revisé PRs,
        mentorizé al equipo y asumí los componentes más críticos.
      </p>
      <p id="about-prose-p-3">
        Desde 2024 hasta agosto de 2026 fui arquitecto de soluciones en
        <strong id="about-prose-strong-3">Quabu Solutions</strong>. Allí diseñé e implementé un sistema orientado a
        eventos sobre DDD, TDD y microservicios para la automatización de almacenes
        inteligentes, con integración de robots, PLC, LEDs, picking y cámaras, y
        comunicación en tiempo real con la operación.
      </p>
    </AutoPreviews>

    <ol id="about-section-trail" class="trail">
      {
        companies.map((company, i) => (
          <li id={`about-trail-li-${i}`} class={`trail-item accent-${company.accent}`}>
            <div id={`about-trail-head-${i}`} class="trail-head">
              <span id={`about-trail-head-name-${i}`} class="trail-name">{company.name}</span>
              <span id={`about-trail-head-span-${i}`} class="trail-span">{spanLabel(company.from, company.to)}</span>
            </div>
            <p id={`about-trail-roles-${i}`} class="trail-roles">
              {company.first.title} → {company.last.title}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="about-section-2" class="section" aria-labelledby="evolucion-title">
    <div id="about-section-head-2" class="section-head">
      <h2 class="section-title" id="evolucion-title">Cómo he llegado hasta aquí</h2>
      <span id="about-section-head-meta-2" class="section-meta">2011 → hoy</span>
    </div>
    <AutoPreviews id="about-section-prose-2" class="prose">
      <p id="about-prose-p-4">
        Quince años dan para pasar por todas las etapas del desarrollo: requisitos,
        implementación, base de datos, mantenimiento, diseño, arquitectura, móvil, web,
        frontend y backend. Empecé de junior y he ido liderando lo que tocaba.
      </p>
      <p id="about-prose-p-5">
        En Basetis diseñé e implementé el core de un buscador en Node: consultas que
        anidaban corchetes —AND, OR, NOT, NOR— y un validador por expresiones regulares.
        Años después supe que aquel motor seguía vivo y que lo habían extendido.
      </p>
      <p id="about-prose-p-6">
        En LoveISDIN lideré el frontend de un producto que el backend definía por partes
        desde un backoffice: los componentes llegaban con su propia iteratividad y el
        frontend tenía que representarlos. Sin criterio de arquitectura para el frontend,
        la parte visual creció en componentes enormes hasta que llegué a Atomic Design, al
        que añadí una capa previa, las partículas: partículas, átomos, moléculas,
        organismos, layouts y páginas. Allí fue también mi primer encuentro con DDD y
        hexagonal en el backend.
      </p>
      <p id="about-prose-p-7">
        Ese hallazgo cambió cómo trabajo. En Bodega Digital llevé por primera vez esa
        arquitectura de backend al frontend, combinando la capa de lógica de DDD con Atomic
        Design. En Nakire TPS la misma idea pasó a microservicios: un DDD core y cada módulo
        con su API, su backoffice y su frontend. En Pachanga Community he vuelto a un
        monolito por capas con un harness determinista, para que el código lo escriban y lo
        prueben agentes y la revisión final siga siendo mía.
      </p>
    </AutoPreviews>
  </section>

  <section id="about-section-3" class="section" aria-labelledby="forma-title">
    <div id="about-section-head-3" class="section-head">
      <h2 class="section-title" id="forma-title">Forma de trabajar</h2>
      <span id="about-section-head-meta-3" class="section-meta">principios</span>
    </div>
    <blockquote id="about-section-working-quote" class="working-quote">
      Me interesa entender el dominio antes de elegir la tecnología. La ingeniería está al
      servicio del negocio: sin entender el negocio, sus necesidades, los requisitos y los
      tiempos, lo demás no sirve de nada.
    </blockquote>
    <ul id="about-section-principles" class="principles">
      {PRINCIPLES.map((principle, i2) => <li id={`about-principles-li-${i2}`}>{principle}</li>)}
    </ul>
  </section>

  <section id="about-section-4" class="section" aria-labelledby="areas-title">
    <div id="about-section-head-4" class="section-head">
      <h2 class="section-title" id="areas-title">Áreas de especialización</h2>
      <span id="about-section-head-meta-4" class="section-meta">{PROJECTS.length} proyectos</span>
    </div>
    <div id="about-section-grid" class="grid grid--2">
      {
        SPECIALTIES.map((specialty, i3) => (
          <div id={`about-grid-card-${i3}`} class="card">
            <h3 id={`about-card-h3-${i3}`}>{specialty.title}</h3>
            <p id={`about-card-p-${i3}`}>{specialty.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="about-section-5" class="section" aria-labelledby="retos-title">
    <div id="about-section-head-5" class="section-head">
      <h2 class="section-title" id="retos-title">Qué tipo de retos busco</h2>
      <span id="about-section-head-meta-5" class="section-meta">enfoque</span>
    </div>
    <AutoPreviews id="about-section-prose-3" class="prose">
      <p id="about-prose-p-8">
        Actualmente me interesan especialmente los retos relacionados con arquitectura
        de plataformas, sistemas distribuidos, productos industriales y liderazgo
        técnico: equipos que necesitan ordenar un sistema que ya creció, separar dominios
        que hoy están acoplados o convertir una integración frágil en algo que se pueda
        mantener.
      </p>
      <p id="about-prose-p-9">
        Disfruto tanto definiendo la arquitectura como bajando al código cuando la
        decisión lo necesita. Y prefiero dejar contexto —decisiones escritas, límites
        explícitos, pruebas sobre el comportamiento real— a dejar una caja negra que solo
        entiende quien la escribió.
      </p>
    </AutoPreviews>
  </section>

  <section id="about-closing" class="closing" aria-labelledby="about-cierre">
    <h2 class="section-title" id="about-cierre">Siguiente paso</h2>
    <p id="about-closing-p">
      Puedes ver el CV completo, recorrer la trayectoria con sus proyectos o escribirme
      directamente para hablar de un reto concreto.
    </p>
    <div id="about-closing-actions" class="actions">
      <a id="about-actions-btn" class="btn" href="/cv/">Ver el CV</a>
      <a id="about-actions-btn-2" class="btn btn--ghost" href="/experience/">Ver experiencia</a>
      <a id="about-actions-btn-3" class="btn btn--ghost" href="/contact/">Contactar</a>
    </div>
  </section>
</Layout>

<style>
  .section {
    display: grid;
  }

  .trail {
    display: grid;
    gap: 0;
    margin-top: 2rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .trail-item {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 0 0.9rem 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .trail-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  .trail-name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .trail-span {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-faint);
  }

  .trail-roles {
    font-size: 0.78125rem;
    color: var(--color-ink-muted);
  }

  .working-quote {
    max-inline-size: 44rem;
    margin-bottom: 1.75rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 2px solid var(--color-border);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .principles {
    display: grid;
    gap: 0.6rem;
    max-inline-size: 44rem;
  }

  .principles li {
    position: relative;
    padding-inline-start: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .principles li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    inline-size: 0.5rem;
    block-size: 1px;
    background: var(--color-ink-faint);
  }

  .closing {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    padding: 1.75rem 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-paper-warm);
  }

  .closing p {
    max-inline-size: 38rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
