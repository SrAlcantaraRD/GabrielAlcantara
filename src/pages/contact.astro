---
import Layout from "../layouts/Layout.astro";
import AutoPreviews from "../components/AutoPreviews.astro";
import { SITE } from "../data/site";

const jsonLd = [
	{
		"@type": "ContactPage",
		"@id": new URL("/contact/", SITE.url).href + "#webpage",
		url: new URL("/contact/", SITE.url).href,
		name: "Contacto | Gabriel Alcántara",
		description:
			"Canales de contacto directo con Gabriel Alcántara para hablar de arquitectura de software, sistemas distribuidos y evolución de plataformas.",
		inLanguage: "es-ES",
		about: { "@id": new URL("/#person", SITE.url).href },
	},
];
---

<Layout
  title="Contacto | Gabriel Alcántara"
  description="Escríbeme para hablar de arquitectura de software, sistemas distribuidos, automatización, liderazgo técnico o evolución de una plataforma existente."
  jsonLd={jsonLd}
  breadcrumbs={[{ label: "Contacto" }]}
>
  <header id="contact-page-head" class="page-head">
    <p id="contact-page-head-eyebrow" class="eyebrow">Contacto</p>
    <h1 id="contact-page-head-display" class="display">Hablemos de tu próximo reto técnico.</h1>
    <p id="contact-page-head-lede" class="lede">
      <AutoPreviews inline id="contact-lede-prose">
        Puedes escribirme si quieres hablar sobre arquitectura de software, sistemas
        distribuidos, automatización, liderazgo técnico o evolución de una plataforma
        existente.
      </AutoPreviews>
    </p>
    <div id="contact-page-head-meta-row" class="meta-row">
      <span id="contact-meta-row-is-available" class="is-available">{SITE.availability}</span>
      <span id="contact-meta-row-span">{SITE.location}</span>
      <span id="contact-meta-row-span-2">respuesta directa</span>
    </div>
  </header>

  <section id="contact-section" class="section" aria-labelledby="canales-title">
    <div id="contact-section-head" class="section-head">
      <h2 class="section-title" id="canales-title">Canales</h2>
      <span id="contact-section-head-meta" class="section-meta">sin formulario intermedio</span>
    </div>
    <div id="contact-section-channels" class="channels">
      <a id="contact-channels-channel" class="channel channel--primary" href={`mailto:${SITE.email}`}>
        <span id="contact-channel-label" class="channel-label">Email profesional</span>
        <span id="contact-channel-value" class="channel-value">{SITE.email}</span>
        <span id="contact-channel-note" class="channel-note">La forma más directa de empezar una conversación.</span>
      </a>
      {
        SITE.socials.map((social, i) => (
          <a id={`contact-channels-channel-2-item-${i}`} class="channel" href={social.href} rel="me">
            <span id={`contact-channel-label-2-item-${i}`} class="channel-label">{social.label}</span>
            <span id={`contact-channel-value-2-item-${i}`} class="channel-value">{social.href.replace("https://", "")}</span>
            <span id={`contact-channel-note-2-item-${i}`} class="channel-note">
              {social.label === "GitHub"
                ? "Código, pruebas y proyectos públicos."
                : "Notas cortas sobre arquitectura y trabajo técnico."}
            </span>
          </a>
        ))
      }
      <a id="contact-channels-channel-2" class="channel" href="/cv/">
        <span id="contact-channel-label-2" class="channel-label">CV</span>
        <span id="contact-channel-value-2" class="channel-value">gabrielalcantara.com/cv</span>
        <span id="contact-channel-note-2" class="channel-note">Versión completa en HTML, con descarga en PDF.</span>
      </a>
    </div>
  </section>

  <section id="contact-section-2" class="section" aria-labelledby="motivos-title">
    <div id="contact-section-head-2" class="section-head">
      <h2 class="section-title" id="motivos-title">Para ayudarme a responder mejor</h2>
      <span id="contact-section-head-meta-2" class="section-meta">contexto</span>
    </div>
    <div id="contact-section-guidance" class="guidance">
      <div id="contact-guidance-div">
        <h3 id="contact-guidance-h3">Incluye en el mensaje</h3>
        <ul id="contact-guidance-ul">
          <li id="contact-guidance-li">Qué problema estás intentando resolver.</li>
          <li id="contact-guidance-li-2">En qué fase se encuentra el proyecto.</li>
          <li id="contact-guidance-li-3">Qué tipo de ayuda necesitas.</li>
          <li id="contact-guidance-li-4">Cómo prefieres continuar la conversación.</li>
        </ul>
      </div>
      <div id="contact-guidance-div-2">
        <h3 id="contact-guidance-h3-2">Motivos habituales</h3>
        <ul id="contact-guidance-ul-2">
          <li id="contact-guidance-li-5">Revisar una arquitectura o una decisión técnica.</li>
          <li id="contact-guidance-li-6">Diseñar o evolucionar un sistema distribuido.</li>
          <li id="contact-guidance-li-7">Conectar software con operaciones o hardware.</li>
          <li id="contact-guidance-li-8">Un rol de arquitectura o Software Engineer en plantilla.</li>
          <li id="contact-guidance-li-9">Mentoría para perfiles senior.</li>
        </ul>
      </div>
    </div>
    <p id="contact-section-expectation" class="expectation">
      <AutoPreviews inline id="contact-expectation-prose">
        Leo todos los mensajes. Si el tema encaja, propongo una primera conversación corta
        para entender el contexto antes de hablar de alcance o de cualquier otra cosa.
      </AutoPreviews>
    </p>
  </section>

  <section id="contact-closing" class="closing" aria-labelledby="contacto-cierre">
    <h2 class="section-title" id="contacto-cierre">¿Seguimos?</h2>
    <p id="contact-closing-p">
      <AutoPreviews inline id="contact-closing-prose">
        Si prefieres ver antes el detalle, puedes empezar por el CV, por los proyectos o por
        los servicios.
      </AutoPreviews>
    </p>
    <div id="contact-closing-actions" class="actions">
      <a id="contact-actions-btn" class="btn" href={`mailto:${SITE.email}`}>Escribir un email</a>
      <a id="contact-actions-btn-2" class="btn btn--ghost" href="/cv/">Ver el CV</a>
      <a id="contact-actions-btn-3" class="btn btn--ghost" href="/projects/">Ver proyectos</a>
    </div>
  </section>
</Layout>

<style>
  .section {
    display: grid;
  }

  .channels {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 768px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .channel {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-card) 70%, transparent);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .channel:hover {
    border-color: color-mix(in srgb, var(--color-ink) 22%, transparent);
    background: var(--color-card);
  }

  .channel--primary {
    border-inline-start: 2px solid var(--color-ink);
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .channel-value {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .channel-note {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .guidance {
    display: grid;
    gap: 2rem;
    max-inline-size: 46rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .guidance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .guidance h3 {
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.656rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .guidance ul {
    display: grid;
    gap: 0.4rem;
  }

  .guidance li {
    position: relative;
    padding-inline-start: 0.9rem;
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .guidance li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    inline-size: 0.35rem;
    block-size: 1px;
    background: var(--color-ink-faint);
  }

  .expectation {
    max-inline-size: 42rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .closing {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    padding: 1.75rem 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-paper-warm);
  }

  .closing p {
    max-inline-size: 38rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
