---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { COMPANIES, POSITION_VIEWS, PROJECTS } from "../data/cv";
import { FEATURED_CASE, SELECTED_CASES } from "../data/projects";
import { FEATURED_POST, OTHER_POSTS, postHref } from "../data/blog";
import { SITE, SPECIALTIES } from "../data/site";
import { spanLabel } from "../lib/period";

const selected = SELECTED_CASES.slice(0, 3);
const posts = OTHER_POSTS.slice(0, 3);

const companies = COMPANIES.map((company) => {
	const own = POSITION_VIEWS.filter(
		(position) => position.companyId === company.id,
	).sort((a, b) => b.startMonth - a.startMonth);
	return {
		...company,
		from: Math.min(...own.map((position) => position.startMonth)),
		to: Math.max(...own.map((position) => position.endMonth)),
		positions: own,
		latest: own[0],
	};
}).sort((a, b) => b.to - a.to);

const personId = new URL("/#person", SITE.url).href;
const pageUrl = new URL("/", SITE.url).href;

const jsonLd = [
	{
		"@type": "ProfilePage",
		"@id": `${pageUrl}#webpage`,
		url: pageUrl,
		name: "Gabriel Alcántara | Software Architect & Software Engineer",
		inLanguage: "es-ES",
		about: { "@id": personId },
		mainEntity: { "@id": personId },
	},
];
---

<Layout
  title="Gabriel Alcántara | Software Architect & Software Engineer"
  description="Arquitecto de software y Software Engineer especializado en sistemas distribuidos, arquitecturas orientadas a eventos, backend y soluciones industriales conectadas."
  type="profile"
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="hero-title">
    <p class="hero-eyebrow">Software Architect · Software Engineer · Distributed Systems</p>
    <h1 class="display" id="hero-title">
      Quince años de evolución, de junior a ingeniero: requisitos, base de datos,
      backend, frontend, móvil y arquitectura.
    </h1>
    <p class="lede">
      Soy Gabriel Alcántara, arquitecto de software y Software Engineer especializado en
      sistemas distribuidos, arquitecturas orientadas a eventos, backend y soluciones
      industriales conectadas.
    </p>
    <div class="actions">
      <a class="btn" href="/projects/">Ver proyectos</a>
      <a class="btn btn--ghost" href="/cv/">Descargar CV</a>
      <a class="btn btn--link" href="/contact/">Contactar conmigo</a>
    </div>
    <div class="meta-row">
      <span class="is-available">{SITE.availability}</span>
      <span>{SITE.location}</span>
      <span>{PROJECTS.length} proyectos en la trayectoria</span>
      <span>desde {SITE.careerStart}</span>
    </div>
  </section>

  <section class="section" aria-labelledby="especialidades-title">
    <div class="section-head">
      <h2 class="section-title" id="especialidades-title">Cuatro áreas de trabajo</h2>
      <span class="section-meta">4 frentes</span>
    </div>
    <div class="grid grid--4">
      {
        SPECIALTIES.map((specialty) => (
          <div class="card">
            <h3>{specialty.title}</h3>
            <p>{specialty.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section featured" aria-labelledby="destacado-title">
    <div class="section-head">
      <h2 class="section-title" id="destacado-title">Proyecto destacado</h2>
      <span class="section-meta">{FEATURED_CASE.company}</span>
    </div>
    <div class="featured-grid">
      <div class="featured-body">
        <p class="eyebrow">Del dominio de negocio a la operación industrial</p>
        <h3 class="featured-name">
          <a href={FEATURED_CASE.caseStudyHref}>{FEATURED_CASE.name}</a>
        </h3>
        <p class="featured-text">{FEATURED_CASE.problem}</p>
        <p class="featured-text">{FEATURED_CASE.outcome}</p>
        <div class="actions">
          <a class="btn" href={FEATURED_CASE.caseStudyHref}>Ver el caso de estudio</a>
          <a class="btn btn--ghost" href="/projects/">Todos los proyectos</a>
        </div>
      </div>
      <dl class="facts featured-facts">
        <dt>Rol</dt>
        <dd>{FEATURED_CASE.role}</dd>
        <dt>Periodo</dt>
        <dd>
          {spanLabel(FEATURED_CASE.startMonth, FEATURED_CASE.endMonth)} ·{" "}
          {FEATURED_CASE.position}
        </dd>
        <dt>Decisión</dt>
        <dd>{FEATURED_CASE.decision}</dd>
        <dt>Tecnologías</dt>
        <dd>
          <span class="tag-row">
            {FEATURED_CASE.stack?.map((item) => <span class="pill">{item}</span>)}
          </span>
        </dd>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="proyectos-title">
    <div class="section-head">
      <h2 class="section-title" id="proyectos-title">Proyectos seleccionados</h2>
      <span class="section-meta">{SELECTED_CASES.length} casos documentados</span>
    </div>
    <div class="grid grid--3">
      {selected.map((project) => <ProjectCard project={project} brief />)}
    </div>
  </section>

  <section class="section" aria-labelledby="experiencia-title">
    <div class="section-head">
      <h2 class="section-title" id="experiencia-title">
        Experiencia: producto, consultoría y arquitectura desde 2011
      </h2>
      <span class="section-meta">{POSITION_VIEWS.length} puestos · {COMPANIES.length} etapas</span>
    </div>
    <p class="section-lede">
      He trabajado en productos digitales, plataformas empresariales y sistemas
      industriales, participando tanto en las decisiones de arquitectura como en su
      implementación y evolución.
    </p>
    <ol class="career">
      {
        companies.map((company) => (
          <li class={`career-item accent-${company.accent}`}>
            <div class="career-head">
              <span class="career-name">{company.name}</span>
              <span class="career-span">
                {spanLabel(company.from, company.to)}
              </span>
            </div>
            <p class="career-roles">
              {company.positions.map((position) => position.title).join(" → ")}
            </p>
            <p class="career-focus">{company.latest.focus}</p>
          </li>
        ))
      }
    </ol>
    <div class="actions">
      <a class="btn btn--ghost" href="/experience/">Ver la trayectoria completa</a>
      <a class="btn btn--link" href="/cv/">CV en HTML</a>
    </div>
  </section>

  <section class="section" aria-labelledby="blog-title">
    <div class="section-head">
      <h2 class="section-title" id="blog-title">Artículos escritos desde proyectos</h2>
      <span class="section-meta">
        <a href="/blog/">Todos los artículos</a>
      </span>
    </div>
    <div class="blog-grid">
      <div class="blog-featured">
        <p class="eyebrow">Artículo destacado</p>
        <h3 class="blog-featured-title">
          <a href={postHref(FEATURED_POST.slug)}>{FEATURED_POST.title}</a>
        </h3>
        <p class="blog-featured-text">{FEATURED_POST.description}</p>
        <a class="btn btn--link" href={postHref(FEATURED_POST.slug)}>Leer el artículo</a>
      </div>
      <div class="blog-list">
        {posts.map((post) => <PostCard post={post} compact />)}
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="cierre-title">
    <h2 class="closing-title" id="cierre-title">
      ¿Hablamos de arquitectura, sistemas distribuidos o evolución técnica?
    </h2>
    <p>
      Si estás trabajando en un problema complejo o necesitas una segunda perspectiva
      técnica, puedes escribirme.
    </p>
    <div class="actions">
      <a class="btn" href="/contact/">Contactar</a>
      <a class="btn btn--ghost" href="/services/">Ver cómo puedo ayudar</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: 1.1rem;
    max-inline-size: 56rem;
    padding-block: 1rem 0.5rem;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.656rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-terracotta);
  }

  .hero .display {
    font-size: clamp(2.2rem, 6vw, 3.7rem);
    max-inline-size: 50rem;
  }

  .section {
    display: grid;
  }

  .section-lede {
    max-inline-size: 46rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .featured-grid {
    display: grid;
    gap: 2rem;
    padding: 1.75rem 1.9rem 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card);
  }

  @media (min-width: 900px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 2.5rem;
      padding: 2.25rem 2.4rem;
    }
  }

  .featured-body {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .featured-name {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .featured-name a {
    text-decoration: none;
  }

  .featured-name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 6px;
  }

  .featured-text {
    max-inline-size: 36rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }

  .featured-facts {
    align-content: start;
    padding-top: 0.1rem;
  }

  .career {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .career-item {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 0.1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding-inline-start: 1rem;
  }

  .career-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  .career-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .career-span {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-faint);
  }

  .career-roles {
    font-size: 0.78125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .career-focus {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .blog-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .blog-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .blog-featured {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.5rem 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-paper-warm);
  }

  .blog-featured-title {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .blog-featured-title a {
    text-decoration: none;
  }

  .blog-featured-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 5px;
  }

  .blog-featured-text {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .blog-list {
    display: grid;
    gap: 0;
    align-content: start;
  }

  .closing {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 2.25rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-paper-warm);
  }

  .closing-title {
    max-inline-size: 36rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .closing p {
    max-inline-size: 38rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
