---
import Layout from "../layouts/Layout.astro";
import ExperienceMatrix from "../components/ExperienceMatrix.astro";
import RoleTrajectory from "../components/RoleTrajectory.astro";
import DetailDrawer from "../components/DetailDrawer.astro";
import {
	COMPANIES,
	EDUCATION,
	POSITION_VIEWS,
	PROJECTS,
	SOFT_SKILLS,
	STACK_GROUPS,
	YEAR_LABEL,
} from "../data/cv";

const updated = new Date().getFullYear();
---

<Layout>
  <header class="site-header">
    <div class="container header-inner">
      <div class="identity">
        <h1>Gabriel Alcántara</h1>
        <p class="tagline">
          Solutions Architect &amp; Tech Lead
          <span class="sep" aria-hidden="true">·</span>
          Sistemas distribuidos, event-driven &amp; IA aplicada
        </p>
      </div>
      <div class="header-meta">
        <span class="availability">
          <span class="dot" aria-hidden="true"></span>disponibilidad activa
        </span>
        <span class="sep" aria-hidden="true">·</span>
        <span>barcelona · remoto</span>
        <span class="sep" aria-hidden="true">·</span>
        <nav class="header-links" aria-label="contacto">
          <a href="mailto:gabriel@alcantaramoreno.com">email</a>
          <a href="https://github.com/SrAlcantaraRD" rel="me">github</a>
          <a href="https://x.com/SrAlcantaraRD" rel="me">x</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="container main">
    <section class="section" id="trayectoria">
      <div class="section-head">
        <h2 class="section-title">Trayectoria &amp; foco longitudinal</h2>
        <span class="section-meta">{YEAR_LABEL}</span>
      </div>
      <ExperienceMatrix />
    </section>

    <section class="section statement" id="perfil">
      <div class="section-head">
        <h2 class="section-title">Perfil</h2>
        <span class="section-meta">2011 — 2026 · 15 años</span>
      </div>
      <p class="statement-lead">
        Durante más de una década he diseñado y construido sistemas de principio
        a fin: convertir un requisito de negocio en una arquitectura que aguante.
      </p>
      <div class="statement-body">
        <p>
          Hasta agosto de 2026 estuve en <strong>Quabu</strong> como
          arquitecto de soluciones. Casi todo lo que hago se resume en microservicios, sistemas
          orientados a eventos (<code>EDA</code>) y APIs REST, con CI/CD y todo
          corriendo en cloud (AWS/Azure). La seguridad y la calidad entran en el
          diseño desde el principio.
        </p>
        <p>
          El proyecto del que más orgulloso estoy es
          <strong>Bodega Digital</strong>: un sistema con arquitectura por
          eventos (<code>EDA + DDD + TDD</code>) para la automatización de
          almacenes con robots, PLC, LEDs y sonidos, donde la IA no solo vive en
          el desarrollo, sino en los propios procesos del sistema — priorizar
          tareas y ejecutarlas, como mover un pallet de
          <code>x1,y1,z1</code> a <code>x2,y2,z2</code>.
        </p>
        <p>
          Empecé en 2011 en <strong>ACD Sistemes</strong>, empresa de producto,
          donde con 21 años viajé a Brasil y Angola a implementar y desplegar
          soluciones de auditoría contable en instituciones públicas. De ahí pasé
          a <strong>BaseTIS</strong>, una consultora grande, donde entré como
          full stack y acabé de team lead: revisando PRs, definiendo PRDs y
          mentorizando al equipo.
        </p>
      </div>
    </section>

    <section class="section" id="experiencia">
      <div class="section-head">
        <h2 class="section-title">Experiencia principal</h2>
        <span class="section-meta">
          {COMPANIES.length} empresas · {POSITION_VIEWS.length} puestos ·{" "}
          {PROJECTS.length} proyectos
        </span>
      </div>
      <RoleTrajectory />
    </section>

    <section class="section focus-grid">
      <div>
        <h3 class="eyebrow">especialidad</h3>
        <p>
          Sistemas distribuidos, arquitecturas orientadas a eventos y
          automatización con robótica industrial. Motores transaccionales con
          seguridad y calidad desde el diseño.
        </p>
      </div>
      <div>
        <h3 class="eyebrow">filosofía</h3>
        <p>
          Arquitectura evolutiva, observabilidad intrínseca y equipos con alta
          autonomía guiados por contratos claros.
        </p>
      </div>
      <div>
        <h3 class="eyebrow">contacto directo</h3>
        <p>
          Abierto a asesorías técnicas, roles de staff/principal y diseño
          estratégico de sistemas.
        </p>
      </div>
    </section>

    <section class="section" id="conocimientos">
      <div class="section-head">
        <h2 class="section-title">Conocimientos técnicos</h2>
        <span class="section-meta">stack</span>
      </div>
      <dl class="stack-groups">
        {
          STACK_GROUPS.map((group) => (
            <div class="stack-group">
              <dt class="eyebrow">{group.label}</dt>
              <dd class="stack-chips">
                {group.items.map((item) => (
                  <span class="pill">{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="soft-skills">{SOFT_SKILLS.join(" · ")}</p>
    </section>

    <section class="section" id="formacion">
      <div class="section-head">
        <h2 class="section-title">Formación</h2>
        <span class="section-meta">{EDUCATION.length} registros</span>
      </div>
      <ul class="education">
        {
          EDUCATION.map((item) => (
            <li class="education-item">
              <span class="education-year">{item.year}</span>
              <span class="education-body">
                <strong>{item.title}</strong>
                <span class="education-org">{item.org}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>Gabriel Alcántara — dossier de arquitectura &amp; currículum</span>
      <span class="footer-meta">
        <span>actualizado {updated}</span>
        <span aria-hidden="true">·</span>
        <span>astro · dokploy</span>
      </span>
    </div>
  </footer>

  <DetailDrawer />
</Layout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .header-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 1.75rem;
  }

  /* A tall sticky header would eat a fifth of a phone viewport. */
  @media (max-width: 767px) {
    .site-header {
      position: static;
      backdrop-filter: none;
    }
  }

  @media (min-width: 640px) {
    .header-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem;
      padding-block: 2.25rem;
    }
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 1.95rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }
  }

  .tagline {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--color-ink-muted);
  }

  .sep {
    margin-inline: 0.4rem;
    color: var(--color-ink-faint);
  }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
  }

  .availability .dot {
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 999px;
    background: var(--color-available);
  }

  .header-links {
    display: flex;
    gap: 1rem;
  }

  .main {
    padding-block: 3rem 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .main {
      padding-block: 4rem 5rem;
    }
  }

  .statement-lead {
    max-inline-size: 44rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--color-ink);
  }

  @media (min-width: 640px) {
    .statement-lead {
      font-size: 1.75rem;
    }
  }

  .statement-body {
    display: grid;
    gap: 1.1rem;
    max-inline-size: 42rem;
    margin-top: 1.75rem;
    color: var(--color-ink-muted);
  }

  .statement-body strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .statement-body code {
    padding: 0.05em 0.3em;
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    background: var(--color-paper-warm);
    color: var(--color-ink-muted);
    font-size: 0.82em;
  }

  .focus-grid {
    display: grid;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .focus-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .focus-grid p {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .focus-grid .eyebrow {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .stack-groups {
    display: grid;
    gap: 0.9rem;
  }

  .stack-group {
    display: grid;
    gap: 0.3rem;
  }

  @media (min-width: 640px) {
    .stack-group {
      grid-template-columns: 6rem minmax(0, 1fr);
      align-items: baseline;
      gap: 1rem;
    }
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
  }

  .soft-skills {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.75rem;
    font-style: italic;
    color: var(--color-ink-faint);
  }

  .education {
    display: grid;
    gap: 0.9rem;
  }

  .education-item {
    display: grid;
    gap: 0.15rem;
  }

  @media (min-width: 640px) {
    .education-item {
      grid-template-columns: 6rem minmax(0, 1fr);
      align-items: baseline;
      gap: 1rem;
    }
  }

  .education-year {
    font-family: var(--font-mono);
    font-size: 0.656rem;
    color: var(--color-ink-faint);
  }

  .education-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .education-body strong {
    font-weight: 500;
    color: var(--color-ink);
  }

  .education-org {
    color: var(--color-ink-muted);
  }

  .education-org::before {
    content: "— ";
    color: var(--color-ink-faint);
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-paper);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: space-between;
    padding-block: 2rem;
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
