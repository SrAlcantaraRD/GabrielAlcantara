---
import Layout from "../layouts/Layout.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import AutoPreviews from "../components/AutoPreviews.astro";
import HeroWheel from "../components/HeroWheel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { COMPANIES, POSITION_VIEWS } from "../data/cv";
import { FEATURED_CASE, SELECTED_CASES } from "../data/projects";
import { FEATURED_POST, OTHER_POSTS, postHref } from "../data/blog";
import { SERVICES, SITE, SPECIALTIES } from "../data/site";
import { spanLabel } from "../lib/period";

const selected = SELECTED_CASES.slice(0, 3);
const posts = OTHER_POSTS.slice(0, 3);

/**
 * The career line reads from 2011 to today, without repeating the same title
 * three times. Siebel is left out: it was five months of a framework, not a
 * step in the progression.
 */
const SKIPPED_ROLES = new Set(["Siebel Developer"]);

function rolesOf(positions: { title: string; startMonth: number }[]) {
	const roles: string[] = [];
	const seen = new Set<string>();
	for (const position of [...positions].sort((a, b) => a.startMonth - b.startMonth)) {
		if (SKIPPED_ROLES.has(position.title)) continue;
		if (seen.has(position.title)) continue;
		seen.add(position.title);
		roles.push(position.title);
	}
	return roles.join(" → ");
}

const companies = COMPANIES.map((company) => {
	const own = POSITION_VIEWS.filter(
		(position) => position.companyId === company.id,
	).sort((a, b) => b.startMonth - a.startMonth);
	return {
		...company,
		from: Math.min(...own.map((position) => position.startMonth)),
		to: Math.max(...own.map((position) => position.endMonth)),
		positions: own,
		latest: own[0],
	};
}).sort((a, b) => b.to - a.to);

const personId = new URL("/#person", SITE.url).href;
const pageUrl = new URL("/", SITE.url).href;

const jsonLd = [
	{
		"@type": "ProfilePage",
		"@id": `${pageUrl}#webpage`,
		url: pageUrl,
		name: "Gabriel Alcántara | Solutions Architect & Software Engineer",
		inLanguage: "es-ES",
		about: { "@id": personId },
		mainEntity: { "@id": personId },
	},
];
---

<Layout
  title="Gabriel Alcántara | Solutions Architect & Software Engineer"
  description={SITE.metaDescription}
  type="profile"
  jsonLd={jsonLd}
>
  <section class="hero" id="sobre" aria-labelledby="hero-title">
    <p id="home-hero-eyebrow" class="hero-eyebrow">Software Engineer - Solutions Architect</p>
    <HeroWheel lines={SITE.headlineLines} words={SITE.headlineWords} />
    <p id="home-hero-lede" class="lede">{SITE.description}</p>
    <p id="home-hero-lede-2" class="lede">
      <AutoPreviews inline id="home-statement-prose" text={SITE.statement} />
    </p>
    <div id="home-hero-actions" class="actions">
      <a id="home-actions-btn" class="btn" href="/contact/">Contactar conmigo</a>
      <a id="home-actions-btn-2" class="btn btn--ghost" href="/projects/">Ver proyectos</a>
    </div>
    <p id="home-hero-secondary" class="hero-secondary">
      <a id="home-actions-btn-3" href="/cv/">Descargar CV</a>
      <span id="home-hero-secondary-span" aria-hidden="true">·</span>
      <a id="home-actions-btn-4" href="/about/">Ver el perfil completo</a>
    </p>
    <div id="home-hero-meta-row" class="meta-row">
      <span id="home-meta-row-is-available" class="is-available">{SITE.availability}</span>
      <span id="home-meta-row-span">{SITE.location}</span>
    </div>
  </section>

  <section id="home-section" class="section" aria-labelledby="especialidades-title">
    <div id="home-section-head" class="section-head">
      <h2 class="section-title" id="especialidades-title">Cuatro áreas de trabajo</h2>
      <span id="home-section-head-meta" class="section-meta">4 frentes</span>
    </div>
    <div id="home-section-grid" class="grid grid--4">
      {
        SPECIALTIES.map((specialty, i) => (
          <div id={`home-grid-card-${i}`} class="card">
            <h3 id={`home-card-h3-${i}`}>{specialty.title}</h3>
            <p id={`home-card-p-${i}`}>
              <AutoPreviews inline id={`home-card-${i}-prose`} text={specialty.body} />
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section featured" id="proyectos" aria-labelledby="destacado-title">
    <div id="home-section-head-2" class="section-head">
      <h2 class="section-title" id="destacado-title">Proyecto destacado</h2>
      <span id="home-section-head-meta-2" class="section-meta">{FEATURED_CASE.company}</span>
    </div>
    <div id="home-section-featured-grid" class="featured-grid">
      <div id="home-featured-grid-body" class="featured-body">
        <p id="home-featured-body-eyebrow" class="eyebrow">Sistemas distribuidos · almacenes robotizados</p>
        <h3 id="home-featured-body-name" class="featured-name">
          <a id="home-featured-name-a" href={FEATURED_CASE.caseStudyHref}>{FEATURED_CASE.name}</a>
        </h3>
        <p id="home-featured-body-text" class="featured-text">
          <AutoPreviews inline id="home-featured-problem-prose" text={FEATURED_CASE.problem} />
        </p>
        <p id="home-featured-body-text-2" class="featured-text">
          <AutoPreviews inline id="home-featured-outcome-prose" text={FEATURED_CASE.outcome} />
        </p>
        <div id="home-featured-body-actions" class="actions">
          <a id="home-actions-btn-5" class="btn" href={FEATURED_CASE.caseStudyHref}>Ver el caso de estudio</a>
          <a id="home-actions-btn-6" class="btn btn--ghost" href="/projects/">Todos los proyectos</a>
        </div>
      </div>
      <dl id="home-featured-grid-facts" class="facts featured-facts">
        <dt id="home-facts-dt">Rol</dt>
        <dd id="home-facts-dd">{FEATURED_CASE.role}</dd>
        <dt id="home-facts-dt-2">Periodo</dt>
        <dd id="home-facts-dd-2">
          {spanLabel(FEATURED_CASE.startMonth, FEATURED_CASE.endMonth)} ·{" "}
          {FEATURED_CASE.position}
        </dd>
        <dt id="home-facts-dt-3">Decisión</dt>
        <dd id="home-facts-dd-3">{FEATURED_CASE.decision}</dd>
        <dt id="home-facts-dt-4">Tecnologías</dt>
        <dd id="home-facts-dd-4">
          <span id="home-facts-tag-row" class="tag-row">
            {FEATURED_CASE.stack?.map((item, i2) => <span id={`home-tag-row-pill-${i2}`} class="pill">{item}</span>)}
          </span>
        </dd>
      </dl>
    </div>
    <div id="home-section-featured-figure" class="featured-figure">
      <ArchitectureDiagram />
    </div>
  </section>

  <section id="home-section-2" class="section" aria-labelledby="proyectos-title">
    <div id="home-section-head-3" class="section-head">
      <h2 class="section-title" id="proyectos-title">Proyectos seleccionados</h2>
      <span id="home-section-head-meta-3" class="section-meta">{selected.length} casos en portada</span>
    </div>
    <div id="home-section-grid-2" class="grid grid--3 is-aligned">
      {selected.map((project) => <ProjectCard project={project} brief />)}
    </div>
  </section>

  <section class="section" id="experiencia" aria-labelledby="experiencia-title">
    <div id="home-section-head-4" class="section-head">
      <h2 class="section-title" id="experiencia-title">
        Experiencia: producto, consultoría y arquitectura desde 2011
      </h2>
      <span id="home-section-head-meta-4" class="section-meta">{POSITION_VIEWS.length} puestos · {COMPANIES.length} etapas</span>
    </div>
    <p id="home-section-lede" class="section-lede">
      <AutoPreviews inline id="home-experience-lede-prose">
        He trabajado en producto digital, plataformas empresariales y sistemas
        industriales, liderando las decisiones técnicas y definiendo la implementación,
        las buenas prácticas y el agent-harness.
      </AutoPreviews>
    </p>
    <ol id="home-section-career" class="career">
      {
        companies.map((company, i3) => (
          <li id={`home-career-li-${i3}`} class={`career-item accent-${company.accent}`}>
            <div id={`home-career-head-${i3}`} class="career-head">
              <span id={`home-career-head-name-${i3}`} class="career-name">{company.name}</span>
              <span id={`home-career-head-span-${i3}`} class="career-span">
                {spanLabel(company.from, company.to)}
              </span>
            </div>
            <p id={`home-career-roles-${i3}`} class="career-roles">{rolesOf(company.positions)}</p>
            <p id={`home-career-focus-${i3}`} class="career-focus">
              <AutoPreviews inline id={`home-career-${i3}-prose`} text={company.latest.focus} />
            </p>
          </li>
        ))
      }
    </ol>
    <div id="home-section-actions" class="actions">
      <a id="home-actions-btn-7" class="btn btn--ghost" href="/experience/">Ver la trayectoria completa</a>
      <a id="home-actions-btn-8" class="btn btn--link" href="/cv/">CV en HTML</a>
    </div>
  </section>

  <section class="section" id="blog" aria-labelledby="blog-title">
    <div id="home-section-head-5" class="section-head">
      <h2 class="section-title" id="blog-title">Artículos escritos desde proyectos</h2>
      <span id="home-section-head-meta-5" class="section-meta">
        <a id="home-section-meta-a" href="/blog/">Todos los artículos</a>
      </span>
    </div>
    <div id="home-section-blog-grid" class="blog-grid">
      <div id="home-blog-grid-featured" class="blog-featured">
        <p id="home-blog-featured-eyebrow" class="eyebrow">Artículo destacado</p>
        <h3 id="home-blog-featured-title" class="blog-featured-title">
          <a id="home-blog-featured-title-a" href={postHref(FEATURED_POST.slug)}>{FEATURED_POST.title}</a>
        </h3>
        <p id="home-blog-featured-text" class="blog-featured-text">
          <AutoPreviews inline id="home-blog-featured-prose" text={FEATURED_POST.description} />
        </p>
        <a id="home-blog-featured-btn" class="btn btn--link" href={postHref(FEATURED_POST.slug)}>Leer el artículo</a>
      </div>
      <div id="home-blog-grid-list" class="blog-list">
        {posts.map((post) => <PostCard post={post} compact />)}
      </div>
    </div>
  </section>

  <section class="section" id="servicios" aria-labelledby="servicios-title">
    <div id="home-section-head-6" class="section-head">
      <h2 class="section-title" id="servicios-title">Cómo puedo ayudar</h2>
      <span id="home-section-head-meta-6" class="section-meta">Colaboración técnica</span>
    </div>
    <div id="home-section-grid-3" class="grid grid--4">
      {
        SERVICES.slice(0, 4).map((service, i4) => (
          <div id={`home-grid-card-2-${i4}`} class="card">
            <h3 id={`home-card-h3-2-${i4}`}>{service.title}</h3>
            <p id={`home-card-p-2-${i4}`}>{service.body}</p>
          </div>
        ))
      }
    </div>
    <div id="home-section-actions-2" class="actions">
      <a id="home-actions-btn-9" class="btn btn--ghost" href="/services/">Ver los {SERVICES.length} servicios</a>
    </div>
  </section>

  <section class="closing" id="contacto" aria-labelledby="cierre-title">
    <h2 class="closing-title" id="cierre-title">
      ¿Hablamos de arquitectura, sistemas distribuidos o evolución técnica?
    </h2>
    <p id="home-closing-p">
      Si estás trabajando en un problema complejo o necesitas una segunda perspectiva
      técnica, puedes escribirme.
    </p>
    <div id="home-closing-actions" class="actions">
      <a id="home-actions-btn-10" class="btn" href="/contact/">Contactar</a>
      <a id="home-actions-btn-11" class="btn btn--ghost" href="/services/">Ver cómo puedo ayudar</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: 1.1rem;
    max-inline-size: 56rem;
    padding-block: 1rem 0.5rem;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-terracotta);
  }

  /* The wide tracking fits one line down to 390px; below that it may wrap. */
  @media (max-width: 480px) {
    .hero-eyebrow {
      letter-spacing: 0.06em;
    }
  }

  /* The two quiet doors out of the hero: present, reachable, not competing. */
  .hero-secondary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  .hero-secondary a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    color: var(--color-ink-muted);
  }

  .hero-secondary a:hover {
    color: var(--color-ink);
  }

  .section {
    display: grid;
  }

  .section-lede {
    max-inline-size: 46rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .featured-grid {
    display: grid;
    gap: 2rem;
    padding: 1.75rem 1.9rem 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card);
  }

  @media (min-width: 900px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 2.5rem;
      padding: 2.25rem 2.4rem;
    }
  }

  .featured-body {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .featured-name {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .featured-name a {
    text-decoration: none;
  }

  .featured-name a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 6px;
  }

  .featured-text {
    max-inline-size: 36rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }

  .featured-facts {
    align-content: start;
    padding-top: 0.1rem;
  }

  /* The featured case shows its architecture: the one artifact on the home. */
  .featured-figure {
    margin-top: 1.75rem;
  }

  .career {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .career-item {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 0.1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding-inline-start: 1rem;
  }

  .career-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  .career-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .career-span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  .career-roles {
    font-size: 0.78125rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .career-focus {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .blog-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .blog-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .blog-featured {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: 1.5rem 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-paper-warm);
  }

  .blog-featured-title {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .blog-featured-title a {
    text-decoration: none;
  }

  .blog-featured-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 5px;
  }

  .blog-featured-text {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .blog-list {
    display: grid;
    gap: 0;
    align-content: start;
  }

  .closing {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 2.25rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-paper-warm);
  }

  .closing-title {
    max-inline-size: 36rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .closing p {
    max-inline-size: 38rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
