    display: grid;
    max-inline-size: 46rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .next-list {
    display: grid;
  }

  .closing {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    padding: 1.75rem 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
