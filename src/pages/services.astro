---
import Layout from "../layouts/Layout.astro";
import AutoPreviews from "../components/AutoPreviews.astro";
import { COLLABORATION, SERVICES, SITE } from "../data/site";
import { FAQ } from "../data/faq";

const servicesUrl = new URL("/services/", SITE.url).href;
const personId = new URL("/#person", SITE.url).href;

const jsonLd = [
	{
		"@type": "WebPage",
		"@id": servicesUrl + "#webpage",
		url: servicesUrl,
		name: "Servicios | Gabriel Alcántara",
		description:
			"Revisión de arquitectura, diseño de sistemas distribuidos, modernización de plataformas y acompañamiento técnico a equipos.",
		inLanguage: "es-ES",
		about: { "@id": personId },
	},
	...SERVICES.map((service) => ({
		"@type": "Service",
		name: service.title,
		description: service.body,
		provider: { "@id": personId },
		mainEntityOfPage: { "@id": servicesUrl + "#webpage" },
	})),
	{
		"@type": "FAQPage",
		"@id": servicesUrl + "#faq",
		mainEntity: FAQ.map((entry) => ({
			"@type": "Question",
			name: entry.question,
			acceptedAnswer: { "@type": "Answer", text: entry.answer },
		})),
	},
];
---

<Layout
  title="Servicios de arquitectura de software y sistemas distribuidos | Gabriel Alcántara"
  description="Colaboración técnica para equipos: revisión de arquitectura, diseño de sistemas distribuidos, modernización de plataformas, integraciones y acompañamiento a equipos."
  jsonLd={jsonLd}
  breadcrumbs={[{ label: "Servicios" }]}
>
  <header id="services-page-head" class="page-head">
    <p id="services-page-head-eyebrow" class="eyebrow">Servicios</p>
    <h1 id="services-page-head-display" class="display">Ayuda técnica en sistemas complejos: revisión, diseño y acompañamiento.</h1>
    <p id="services-page-head-lede" class="lede">
      Puedo colaborar con equipos que necesiten revisar una arquitectura, evolucionar una
      plataforma o convertir un problema técnico complejo en pasos concretos.
    </p>
    <div id="services-page-head-actions" class="actions">
      <a id="services-actions-btn" class="btn" href="/contact/">Comentar un reto técnico</a>
      <a id="services-actions-btn-2" class="btn btn--ghost" href="/projects/">Ver proyectos</a>
    </div>
  </header>

  <section id="services-section" class="section" aria-labelledby="servicios-title">
    <div id="services-section-head" class="section-head">
      <h2 class="section-title" id="servicios-title">Tipos de colaboración</h2>
      <span id="services-section-head-meta" class="section-meta">{SERVICES.length} frentes</span>
    </div>
    <div id="services-section-grid" class="grid grid--2">
      {
        SERVICES.map((service, i) => (
          <div id={`services-grid-card-${i}`} class="card">
            <h3 id={`services-card-h3-${i}`}>{service.title}</h3>
            <p id={`services-card-p-${i}`}>
              <AutoPreviews inline id={`services-card-${i}-prose`} text={service.body} />
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="services-section-2" class="section" aria-labelledby="como-title">
    <div id="services-section-head-2" class="section-head">
      <h2 class="section-title" id="como-title">Cómo trabajo</h2>
      <span id="services-section-head-meta-2" class="section-meta">contexto antes que solución</span>
    </div>
    <ol id="services-section-steps" class="steps">
      {
        COLLABORATION.map((step, index) => (
          <li id={`services-steps-step-${index}`} class="step">
            <span id={`services-step-number-${index}`} class="step-number">{String(index + 1).padStart(2, "0")}</span>
            <p id={`services-step-p-${index}`}>
              <AutoPreviews inline id={`services-step-${index}-prose`} text={step} />
            </p>
          </li>
        ))
      }
    </ol>
    <p id="services-section-scope-note" class="scope-note">
      <AutoPreviews inline id="services-scope-note-prose">
        No trabajo como una agencia: prefiero pocas colaboraciones donde pueda implicarme
        en las decisiones y en su ejecución. Si el problema encaja, te lo digo; si no, también.
      </AutoPreviews>
    </p>
  </section>

  <section id="services-section-3" class="section" aria-labelledby="faq-title">
    <div id="services-section-head-3" class="section-head">
      <h2 class="section-title" id="faq-title">Preguntas frecuentes</h2>
      <span id="services-section-head-meta-3" class="section-meta">{FAQ.length} respuestas</span>
    </div>
    <dl id="services-section-faq" class="faq">
      {
        FAQ.map((entry, i2) => (
          <div id={`services-faq-item-${i2}`} class="faq-item">
            <dt id={`services-faq-item-dt-${i2}`}>{entry.question}</dt>
            <dd id={`services-faq-item-dd-${i2}`}>
              <AutoPreviews inline id={`services-faq-${i2}-prose`} text={entry.answer} />
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="services-closing" class="closing" aria-labelledby="servicios-cierre">
    <h2 class="section-title" id="servicios-cierre">¿Empezamos por el problema?</h2>
    <p id="services-closing-p">
      <AutoPreviews inline id="services-closing-prose">
        Cuéntame qué está pasando, en qué fase está el proyecto y qué tipo de ayuda
        necesitas. Con eso puedo decirte si encaja y cómo lo abordaría.
      </AutoPreviews>
    </p>
    <div id="services-closing-actions" class="actions">
      <a id="services-actions-btn-3" class="btn" href="/contact/">Contactar</a>
      <a id="services-actions-btn-4" class="btn btn--ghost" href={`mailto:${SITE.email}`}>Escribir un email</a>
    </div>
  </section>
</Layout>

<style>
  .section {
    display: grid;
  }

  .steps {
    display: grid;
    gap: 1rem;
    max-inline-size: 46rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .step {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: 0.656rem;
    letter-spacing: 0.12em;
    color: var(--color-terracotta);
  }

  .step p {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .scope-note {
    max-inline-size: 42rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .faq {
    display: grid;
    gap: 1.25rem;
    max-inline-size: 46rem;
  }

  .faq-item {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
  }

  .faq dt {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .faq dd {
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }

  .closing {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    padding: 1.75rem 1.9rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-paper-warm);
  }

  .closing p {
    max-inline-size: 38rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
  }
</style>
